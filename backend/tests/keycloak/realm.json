{
  "realm": "identity-test",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "plone",
      "name": "Plone",
      "enabled": true,
      "protocol": "openid-connect",
