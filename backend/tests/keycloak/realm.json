  "users": [
    {
      "username": "elena",
      "email": "elena@example.org",
      "firstName": "Elena",
      "lastName": "Example",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "elena-password",
          "temporary": false
        }
      ]
    }
  ]
}
