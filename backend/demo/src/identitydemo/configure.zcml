<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="identitydemo"
    >

  <!-- Products.PrintingMailHost patches MailHost to write messages to the
       log. Loaded here because the Product ships no ZCML of its own, so
       nothing else in the image can load it; see startup.py. -->
  <subscriber
      for="zope.processlifetime.IProcessStarting"
      handler=".startup.print_mail_instead_of_sending"
      />

  <genericsetup:registerProfile
      name="idp"
      title="Identity demo: identity provider"
      description="Site A of the federation demo. An OpenID Connect provider."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/idp"
      post_handler=".setuphandlers.idp.install_idp"
      />

  <genericsetup:registerProfile
      name="rp"
      title="Identity demo: relying party"
      description="Site B of the federation demo. Points an oidc-generic provider at site A."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/rp"
      post_handler=".setuphandlers.rp.install_rp"
      />

</configure>
