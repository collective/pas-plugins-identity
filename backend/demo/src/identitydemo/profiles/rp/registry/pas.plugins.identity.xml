<?xml version="1.0" encoding="utf-8"?>
<registry>

  <records interface="pas.plugins.identity.core.controlpanel.interfaces.IIdentitySettings"
           prefix="pas.plugins.identity"
  >
    <value key="audit_max_days">180</value>
    <value key="audit_max_entries">500</value>
    <value key="audit_record_pii">False</value>
    <!-- Both destinations, which is the arrangement worth showing:
         the site keeps its own bounded log, and every event is also
         written to the PostgreSQL service in the compose file, where
         it is unbounded and outlives the container. ``plugin`` is
         first, so the control panel still reads the ZODB log; swap
         the order to read from the database instead. -->
    <value key="audit_sinks">
      <element>plugin</element>
      <element>sql</element>
    </value>
    <value key="discovery_timeout">10</value>
    <value key="portrait_max_bytes">2097152</value>
    <value key="portrait_timeout">5</value>
    <value key="sync_portraits">True</value>
    <!-- ``callback_url`` and the provider's ``issuer`` are deliberately not
         stated here. Both are read from the environment by
         ``identitydemo.settings`` and written by ``install_rp``, because the
         hermetic federation stack and the manual Traefik stack do not agree on
         them and XML cannot read an environment variable. -->
  </records>

  <!-- The five fields every provider has, whatever its driver, come from
       IProviderRecords, so nothing here restates a type. The driver's own
       settings below cannot: which of them exist, and what type each one is,
       comes from the driver's config_schema at runtime, so each carries its
       own field element. A record with neither an interface nor a field
       element imports only into a site that already has it.

       Claim paths on the left of the property map, Plone fields on the right,
       never the other way round. What this identity provider actually
       publishes is decided by server.claims.SCOPE_CLAIMS: name,
       preferred_username, website, picture, description, email,
       email_verified and address.

       The map is written against the *normalized* claim names where
       normalization produces one (name arrives as fullname, picture as
       picture_url), and against the raw claim where it does not.

       address.formatted is the dotted path this package's property map exists
       for: the provider sends address as an object, and the formatted member
       is the human-readable line. -->
  <records interface="pas.plugins.identity.core.controlpanel.interfaces.IProviderRecords"
           prefix="pas.plugins.identity.providers.demo-idp"
  >
    <value key="driver">plone-identity</value>
    <value key="title">id.localhost</value>
    <value key="enabled">True</value>
    <value key="order">0</value>
    <value key="propertymap">
      <element key="fullname">fullname</element>
      <element key="email">email</element>
      <element key="website">home_page</element>
      <element key="description">description</element>
      <element key="address.formatted">location</element>
      <element key="picture_url">portrait</element>
    </value>

    <value key="groupmap">
      <element key="content-site-editors">Reviewers</element>
    </value>
  </records>

  <record name="pas.plugins.identity.providers.demo-idp.config.client_id">
    <field type="plone.registry.field.TextLine">
      <required>False</required>
    </field>
    <value>demo-rp</value>
  </record>
  <record name="pas.plugins.identity.providers.demo-idp.config.client_secret">
    <field type="plone.registry.field.Password">
      <required>False</required>
    </field>
    <value>demo-secret-not-for-any-real-site</value>
  </record>
  <record name="pas.plugins.identity.providers.demo-idp.config.scope">
    <field type="plone.registry.field.Tuple">
      <required>False</required>
      <value_type type="plone.registry.field.TextLine" />
    </field>
    <value>
      <element>openid</element>
      <element>email</element>
      <element>profile</element>
      <element>address</element>
    </value>
  </record>
  <!-- The demo stack has no certificate, so the portrait the identity
       provider publishes is on a plain-HTTP URL. Every reason not to do this
       is in core/portraits.py; none of them apply to two containers on a
       laptop, and without it the portrait half of the federation cannot be
       exercised at all. -->

  <record name="pas.plugins.identity.providers.demo-idp.config.picture_over_http">
    <field type="plone.registry.field.Bool">
      <required>False</required>
    </field>
    <value>True</value>
  </record>
  <record name="pas.plugins.identity.providers.demo-idp.config.userid_source">
    <field type="plone.registry.field.TextLine">
      <required>False</required>
    </field>
    <value>username</value>
  </record>

</registry>
