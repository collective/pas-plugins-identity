<?xml version="1.0" encoding="utf-8"?>
<registry xmlns:i18n="http://xml.zope.org/namespaces/i18n"
          i18n:domain="identitydemo"
>

  <records interface="pas.plugins.identity.core.controlpanel.interfaces.IIdentitySettings"
           prefix="pas.plugins.identity"
  >

    <!-- Without this the relying party answers 502 on the login endpoint and
         says so, which is correct and is the first thing a new deployment
         hits. It has to be the same literal as DEMO_REDIRECT_URI in
         identitydemo.settings and as the redirect URI registered with the
         identity provider: the token endpoint compares them byte for byte. -->
    <value key="callback_url">http://plone.localhost:8081/login-identity</value>

  </records>

</registry>
