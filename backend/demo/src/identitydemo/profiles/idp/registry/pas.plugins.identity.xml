  <!-- The five fields every provider has, whatever its driver, come from
       IProviderRecords, so nothing here restates a type. The driver's own
       settings below cannot: which of them exist, and what type each one is,
       comes from the driver's config_schema at runtime, so each carries its
       own field element. A record with neither an interface nor a field
       element imports only into a site that already has it. -->
  <!-- Magic-link login. First on the login page, and it is the one way in
       that needs nothing configured anywhere else: no OAuth client, no
       secret, no account at a third party. The mailbox is the provider.

       Nothing is actually delivered in this stack: the site's MailHost is
       Products.PrintingMailhost, which writes the message to the log
       instead. `make demo-stack-logs` is where the link is, which is what
       makes this demonstrable without a mail server. -->
  <records interface="pas.plugins.identity.core.controlpanel.interfaces.IProviderRecords"
           prefix="pas.plugins.identity.providers.email"
  >
    <value key="driver">email</value>
    <value key="title">Email</value>
    <value key="enabled">True</value>
    <value key="order">0</value>
    <value key="propertymap">
      <element key="email">email</element>
    </value>
  </records>

  <record name="pas.plugins.identity.providers.email.config.token_ttl">
    <field type="plone.registry.field.Int">
      <required>False</required>
    </field>
    <!-- An hour rather than the default fifteen minutes: somebody reading a
         link out of a container log is slower than somebody reading it out
         of their inbox. -->
    <value>3600</value>
  </record>
  <record name="pas.plugins.identity.providers.email.config.rate_limit_per_hour">
    <field type="plone.registry.field.Int">
      <required>False</required>
    </field>
    <value>20</value>
  </record>

  <records interface="pas.plugins.identity.core.controlpanel.interfaces.IProviderRecords"
           prefix="pas.plugins.identity.providers.github"
  >
    <value key="driver">github</value>
    <value key="title">GitHub</value>
    <value key="enabled">True</value>
    <!-- After the magic link, which is the way in this stack can actually
         complete without credentials at a third party. -->
    <value key="order">1</value>
    <value key="propertymap">
      <element key="name">fullname</element>
      <element key="email">email</element>
      <element key="bio">description</element>
      <element key="blog">home_page</element>
      <element key="location">location</element>
      <element key="picture_url">portrait</element>
    </value>
  </records>

