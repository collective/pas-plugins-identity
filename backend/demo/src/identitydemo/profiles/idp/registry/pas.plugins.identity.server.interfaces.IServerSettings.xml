<?xml version="1.0" encoding="utf-8"?>
<registry xmlns:i18n="http://xml.zope.org/namespaces/i18n"
          i18n:domain="identitydemo"
>

  <records interface="pas.plugins.identity.server.interfaces.IServerSettings"
           prefix="pas.plugins.identity"
  >

    <!-- Until this is set the server signs nothing and discovery answers 503,
         which is the correct initial state for a real site and the one thing
         a demo has to decide for itself. It has to match IDP_PUBLIC_URL in
         identitydemo.settings byte for byte: it is the `iss` in every token,
         and the relying party compares it as a string. -->
    <value key="server_issuer">http://id.localhost:8080/Plone</value>

  </records>

</registry>
