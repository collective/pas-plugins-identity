# syntax=docker/dockerfile:1
#
# The federation demo image. One image, run twice: which site it
# becomes is decided by APPLY_PROFILES at container start, because the
# identity provider and the relying party differ in configuration and not in
# code.
#
# Separate from Dockerfile on purpose. The demo package carries a client
# secret and a user password as literals, so it must not be reachable from
# the production image at all -- not merely guarded there.
ARG PLONE_VERSION=6.2.1
FROM plone/server-builder:${PLONE_VERSION} AS builder

WORKDIR /app

COPY scripts/ scripts/
COPY . src

RUN <<EOT
    set -e
    bin/pip install mxdev uv
    # ``content`` was merged into core and the extra no longer exists;
    # naming it here only earned a warning from the installer. ``sql`` is
    # what the demo now needs, for the audit sink that writes to PostgreSQL.
    sed -i 's/-e .\[test\]/.[server,sql]/g' src/mx.ini
    cd /app/src
    rm -rf .venv
    ../bin/mxdev -c mx.ini
    ../bin/uv pip install -r requirements-mxdev.txt
    # The demo, explicitly and only here.
    #
    # Installed with its dependencies, under the constraints mxdev just
    # generated. It used to be --no-deps, on the reasoning that everything it
    # needed had arrived above -- which was true of every dependency except
    # its own: Products.PrintingMailHost is declared by the demo package and
    # by the backend's [test] extra, and the sed above swaps [test] for the
    # runtime extras, so it reached the image by neither route. The magic
    # link, which is most of what this stack is for, opened a real SMTP
    # connection and answered 500.
    #
    # Constraints rather than --no-deps: they are what stops a version being
    # silently resolved past a Plone pin, which is what --no-deps was
    # reaching for.
    ../bin/uv pip install -c constraints-mxdev.txt ./demo
    ../bin/python /compile_mo.py
EOT

FROM plone/server-prod-config:${PLONE_VERSION}

LABEL maintainer="Érico Andrei <ericof@plone.org>" \
      org.label-schema.name="pas-plugins-identity-demo" \
      org.label-schema.description="Federation demo for pas.plugins.identity. Not for deployment." \
      org.label-schema.vendor="Érico Andrei"

COPY --from=builder /app /app

# The demo owns its own site creation. The repository's script hardcodes
# pas.plugins.identity:default and ignores APPLY_PROFILES, which cannot
# express "this image is the identity provider and that one is the relying
# party". DEMO_PROFILE decides, and has no default.
COPY demo/scripts/create_site.py /app/scripts/create_site.py
COPY container/docker-entrypoint.sh /app/docker-entrypoint.sh

RUN <<EOT
    set -e
    ln -s /data /app/var
EOT
