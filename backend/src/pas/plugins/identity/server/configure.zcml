<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="pas.plugins.identity"
    >

  <include file="profiles.zcml" />

  <!-- Every endpoint this package publishes is registered in ``.browser``,
       and every one of them is bound to ``.interfaces.IIdentityServerLayer``.
       An /authorize endpoint in a site that never switched the server on is
       an attack surface rather than an idle feature, so the browser layer is
       what keeps it absent rather than merely unused. -->

  <include package=".browser" />

  <!-- Registered outside the browser layer: a vocabulary is looked up by
       name while a schema field is validated, and that happens wherever the
       client registry is written from, a setup handler included. -->
  <include package=".vocabularies" />

  <include package=".controlpanel" />
  <include package=".services" />
  <include package=".subscribers" />

</configure>
