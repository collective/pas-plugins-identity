<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    xmlns:zcml="http://namespaces.zope.org/zcml"
    i18n_domain="pas.plugins.identity"
    >

  <i18n:registerTranslations directory="locales" />

  <include
      package="Products.CMFCore"
      file="permissions.zcml"
      />

  <include file="dependencies.zcml" />
  <include file="profiles.zcml" />
  <include file="permissions.zcml" />

  <include package=".core" />

  <!-- The optional layers. Their ZCML loads whenever their dependency
       is importable; what actually switches them on in a site is applying the
       matching GenericSetup profile, which is what installs the tools, the
       types and the browser layer their registrations are bound to.

       On Plone 6.2 the ``[profile]`` condition is always true — p.a.dexterity
       ships with Plone — so this guard is a declaration of what the layer
       needs rather than a discriminator. The real isolation guarantees are the
       import-linter contract and the separate GS profile; the ``[server]``
       extra, whose cryptography dependency is genuinely optional, is the one
       the condition switches off in practice. -->
  <include
      package=".profile"
      zcml:condition="installed plone.app.dexterity"
      />

</configure>
