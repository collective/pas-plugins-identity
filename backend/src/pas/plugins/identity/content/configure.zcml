<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="pas.plugins.identity"
    >

  <include file="profiles.zcml" />

  <class class=".group.UserGroup">
    <implements interface=".interfaces.IUserGroup" />
  </class>

  <!-- The Profile marker is applied to the class rather than through the FTI
       so that the catalog subscribers below bind to it however the object was
       constructed — including by a test that instantiates it directly. -->
  <class class=".profile.UserProfile">
    <implements interface=".interfaces.IUserProfile" />
  </class>

  <!-- Catalog maintenance. Registered for the marker, so a site
       without the ``profile`` GenericSetup profile applied has these
       subscribers loaded and inert: there are no Profiles to fire them, and
       ``query_catalog`` answers None if one somehow appears. -->
  <subscriber
      for=".interfaces.IIdentityCatalogued
           zope.lifecycleevent.interfaces.IObjectMovedEvent"
      handler=".indexing.profile_moved"
      />

  <subscriber
      for=".interfaces.IIdentityCatalogued
           OFS.interfaces.IObjectWillBeMovedEvent"
      handler=".indexing.profile_will_be_moved"
      />

  <subscriber
      for=".interfaces.IIdentityCatalogued
           zope.lifecycleevent.interfaces.IObjectModifiedEvent"
      handler=".indexing.profile_modified"
      />

  <!-- A transition changes review_state, which is both an index and a
       metadata column, and fires no modification event of its own. -->
  <subscriber
      for=".interfaces.IIdentityCatalogued
           Products.DCWorkflow.interfaces.IAfterTransitionEvent"
      handler=".indexing.profile_modified"
      />

  <!-- Keep the workflow state honest about what the profile carries. Bound to
       the Profile marker rather than to the catalog one: a Group has no
       required-information flow, and firing a transition it does not have
       would be an error rather than a no-op.

       Added as well as modified. A profile created with everything already in
       it (by api.user.create, by @users POST, by an import) fires no
       modification event at all, and would otherwise sit in incomplete
       waiting for a write that never comes. -->
  <subscriber
      for=".interfaces.IUserProfile
           zope.lifecycleevent.interfaces.IObjectAddedEvent"
      handler=".subscribers.on_profile_modified"
      />

  <subscriber
      for=".interfaces.IUserProfile
           zope.lifecycleevent.interfaces.IObjectModifiedEvent"
      handler=".subscribers.on_profile_modified"
      />

  <!-- Both indexers fold or narrow what the field literally holds; see the
       module for why. -->
  <adapter
      factory=".indexing.login_index"
      name="login"
      />

  <adapter
      factory=".indexing.searchable_text_index"
      name="SearchableText"
      />

  <!-- First login and claims sync. Registered for the event
       contract only: this layer never reaches into core, and anything
       that fires the events gets profile handling for free. -->
  <subscriber
      for="pas.plugins.identity.core.events.IExternalIdentityAuthenticated"
      handler=".subscribers.on_authenticated"
      />

  <subscriber
      for="pas.plugins.identity.core.events.IIdentityLinked"
      handler=".subscribers.on_identity_linked"
      />

  <subscriber
      for="pas.plugins.identity.core.events.IUserClaimsRefreshed"
      handler=".subscribers.on_claims_refreshed"
      />

  <!-- A user may edit their own Profile and nobody else's. Computed rather
       than assigned, so there is nothing to keep in step. -->
  <adapter factory=".localroles.ProfileSelfRole" />

  <!-- What core is allowed to ask this layer, without importing it. Core
       looks the utility up and gets None on a site without the extra, which
       is the answer "there is no content layer here". -->
  <utility factory=".support.ProfileSupport" />


  <!-- Volto's first-login routing question. Authenticated-only, checked in
       the service so the refusal is a JSON body rather than a login form. -->
  <plone:service
      method="GET"
      factory=".services.myprofile.MyProfileGet"
      for="Products.CMFCore.interfaces.ISiteRoot"
      permission="zope2.View"
      layer=".interfaces.IIdentityContentLayer"
      name="@my-profile"
      />

  <!-- @types, with the site's required profile fields in the schema the edit
       form is built from. plone.restapi reads ``required`` off the type and
       nothing else, so a field required by the registry record but optional
       on the type would hold a profile incomplete while the form accepted a
       save without it. That is a loop, and the record alone would create it.
       See .services.types. -->
  <plone:service
      method="GET"
      accept="application/json,application/schema+json"
      factory=".services.types.ProfileTypesGet"
      for="*"
      permission="zope2.View"
      layer=".interfaces.IIdentityContentLayer"
      name="@types"
      />

  <!-- plone.restapi's own @users PATCH, with the portrait written to the
       Profile that owns it rather than to portal_memberdata. Registered for
       this layer, so the override exists exactly where a Profile does. -->
  <plone:service
      method="PATCH"
      factory=".services.users.ProfileUsersPatch"
      for="Products.CMFCore.interfaces.ISiteRoot"
      permission="zope2.View"
      layer=".interfaces.IIdentityContentLayer"
      name="@users"
      />

  <!-- Off unless a site enables it on a type. Without it a new user's
       password goes to source_users, which is where Plone has always kept
       one. See .behaviors for the four ways a Dexterity field holding a
       credential leaks it, and why the hash is an annotation. -->
  <plone:behavior
      name="pas.plugins.identity.password"
      title="Password storage"
      description="Keep this user's password on the object rather than in source_users."
      factory=".behaviors.PasswordStorage"
      provides="pas.plugins.identity.core.interfaces.ICredentialStorage"
      for="pas.plugins.identity.core.interfaces.IUserContent"
      />

  <subscriber
      for="pas.plugins.identity.core.interfaces.IUserContent
           zope.lifecycleevent.interfaces.IObjectCopiedEvent"
      handler=".behaviors.clear_on_copy"
      />

  <!-- The required-information gate. Registered for the publication event
       rather than around a view, because what it enforces is that there is no
       page to reach instead. It excludes far more than it catches, and each
       exclusion is a way the gate would otherwise break the escape it depends
       on; see .gate. -->
  <subscriber
      for="ZPublisher.interfaces.IPubAfterTraversal"
      handler=".gate.on_after_traversal"
      />

  <!-- Where Profiles live is configurable and set late. A layered profile
       may move the container after this package's handler has run, so the
       core record naming it is derived and re-derived rather than written
       once. See .principals. -->
  <subscriber
      for="plone.registry.interfaces.IRecordModifiedEvent"
      handler=".principals.on_container_setting_changed"
      />

  <!-- The other half of the same problem. A container this package did not
       create gets no add permission from the creation path, and neither the
       install handler nor the settings subscriber ever sees it: one runs too
       early and the other watches records rather than content. A folder
       appearing at the configured path is the third case, and the demo hits
       it on every fresh site. -->
  <subscriber
      for="Products.CMFCore.interfaces.IFolderish
           zope.lifecycleevent.interfaces.IObjectAddedEvent"
      handler=".principals.on_folder_added"
      />

  <!-- The read side of the same decision. plone.restapi's @portrait reads
       portal_memberdata only, so it answered 404 for a user whose picture is
       on their Profile - including when the [server] layer publishes this
       URL as the OIDC picture claim and a relying party fetches it. -->
  <plone:service
      method="GET"
      factory=".services.users.ProfilePortraitGet"
      for="Products.CMFCore.interfaces.ISiteRoot"
      permission="zope2.View"
      layer=".interfaces.IIdentityContentLayer"
      name="@portrait"
      />

</configure>
