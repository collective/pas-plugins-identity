<?xml version="1.0" encoding="utf-8"?>
<object xmlns:i18n="http://xml.zope.org/namespaces/i18n"
        meta_type="Dexterity FTI"
        name="PrincipalsContainer"
        i18n:domain="pas.plugins.identity"
>
  <property name="title"
            i18n:translate=""
  >Principals folder</property>
  <property name="description"
            i18n:translate=""
  >A folder of user profiles and groups.</property>
  <!-- Principals only. Which of the two may actually be added in a given
       container is the add permission's answer, granted on the container
       for the kind the registry files there. -->
  <property name="allowed_content_types">
    <element value="UserProfile" />
    <element value="UserGroup" />
  </property>
  <property name="filter_content_types">True</property>
  <!-- A folder that does not filter its types, the site root included,
       takes only the types that are globally allowed. The package creates
       this one at the site root by default, so it has to be one of them;
       who may add it is the add permission's business. -->
  <property name="global_allow">True</property>
  <property name="icon_expr">string:folder</property>
  <property name="klass">pas.plugins.identity.core.contents.principals.PrincipalsContainer</property>
  <property name="schema">pas.plugins.identity.core.contents.principals.IPrincipalsContainerSchema</property>
  <property name="add_permission">pas.plugins.identity.principalscontainer.add</property>
  <property name="link_target" />
  <property name="model_source" />
  <property name="model_file" />

  <!-- plone.shortname is absent on purpose. The registry names the
       container by its id, so renaming it would leave the records pointing
       at a folder that no longer exists, and the next principal created
       would get a new, empty one. -->
  <property name="behaviors">
    <element value="plone.basic" />
    <element value="plone.excludefromnavigation" />
    <element value="volto.blocks" />
  </property>

  <alias from="(Default)"
         to="(dynamic view)"
  />
  <alias from="edit"
         to="@@edit"
  />
  <alias from="sharing"
         to="@@sharing"
  />
  <alias from="view"
         to="(selected layout)"
  />

  <action action_id="view"
          category="object"
          condition_expr=""
          title="View"
          url_expr="string:${object_url}"
          visible="True"
          i18n:attributes="title"
  >
    <permission value="View" />
  </action>
  <action action_id="edit"
          category="object"
          condition_expr=""
          title="Edit"
          url_expr="string:${object_url}/edit"
          visible="True"
          i18n:attributes="title"
  >
    <permission value="Modify portal content" />
  </action>
</object>
