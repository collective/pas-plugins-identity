<?xml version="1.0" encoding="utf-8"?>
<rolemap>
  <permissions>
    <!-- Granted to nobody, on purpose, and this is not an oversight to be
         tidied up later.

         Both types are addable in exactly one place: the container the
         registry names for them, where
         ``pas.plugins.identity.core.container`` grants the permission to
         Manager and Site Administrator locally. Granting it here as well
         would make every folder in the site a place a UserProfile can be
         created, which is the thing being prevented.

         ``acquire="False"`` matters even with no roles listed. A permission
         nobody mentions is not a permission nobody has: Zope falls back to
         whatever the object acquires, so the answer would change with where
         the folder happens to be. -->
    <permission acquire="False"
                name="pas.plugins.identity: Add User Profile"
    />

    <permission acquire="False"
                name="pas.plugins.identity: Add User Group"
    />

    <!-- The rest are the field permissions declared on the schema in
         ``pas.plugins.identity.core.contents.profile``. Every one of them is also managed by
         ``user_profile_workflow``, which is what decides who may read
         and write a Profile in each of its states; these entries are the
         site-wide floor for anywhere the workflow does not reach.

         Stating them matters even so. A permission that no rolemap mentions
         is not a permission nobody has: Zope falls back to whatever the
         object acquires, and for a field permission that means the answer
         changes with where the Profile happens to live. -->
    <permission acquire="False"
                name="pas.plugins.identity: Edit Profile"
    >
      <role name="Manager" />
      <role name="Site Administrator" />
    </permission>

    <!-- Never granted to the profile's owner, in any state, which is the
         whole reason it is a permission of its own: ``group_ids`` decides
         which groups a user is in, so writing it is granting yourself
         roles. -->
    <permission acquire="False"
                name="pas.plugins.identity: Edit Profile Group Membership"
    >
      <role name="Manager" />
      <role name="Site Administrator" />
    </permission>

    <!-- A login may be rewritten by a Manager and by nobody else once the
         Profile exists. It is half of the case folded index that user
         enumeration queries, so changing it moves the account away from
         every sign in and Sharing entry written against the old name.

         Site Administrator is absent here on purpose, and is granted this
         on the container instead: that is what keeps the field on the add
         form for whoever may file a principal, while the workflow holds the
         object itself to Manager. See core.container.LOGIN_ROLES. -->
    <permission acquire="False"
                name="pas.plugins.identity: Edit Profile Login"
    >
      <role name="Manager" />
    </permission>

    <!-- What a group is allowed to do, as opposed to who is in it. Manager
         alone, and not Site Administrator: anyone who can write it can grant
         the group ``Manager`` and then join the group. -->
    <permission acquire="False"
                name="pas.plugins.identity: Edit Group Global Roles"
    >
      <role name="Manager" />
    </permission>

    <permission acquire="False"
                name="pas.plugins.identity: View Profile"
    >
      <role name="Manager" />
      <role name="Site Administrator" />
    </permission>

    <!-- Separate from ``View Profile`` so that a site can let members find
         each other without publishing everybody's email address. The
         workflow never grants it to ``Member``, in any state. -->
    <permission acquire="False"
                name="pas.plugins.identity: View Personal Identifiable Information"
    >
      <role name="Manager" />
      <role name="Site Administrator" />
    </permission>

    <!-- An export carries every client secret in the clear. Manager alone,
         and apart from ``Manage portal``: a site that lets another role
         manage the providers has not let it read every secret, which
         managing a provider never needs. -->
    <permission acquire="False"
                name="pas.plugins.identity: Export Identity Providers"
    >
      <role name="Manager" />
    </permission>
  </permissions>
</rolemap>
