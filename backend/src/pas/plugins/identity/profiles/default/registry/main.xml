<?xml version="1.0" encoding="utf-8"?>
<registry xmlns:i18n="http://xml.zope.org/namespaces/i18n"
          i18n:domain="pas.plugins.identity"
>

  <!-- Configured providers, as a JSON list. One record keeps the whole
       configuration GenericSetup-exportable in a single place (§4.5). -->
  <record name="pas.plugins.identity.providers">
    <field type="plone.registry.field.Text">
      <title>Providers</title>
      <description>JSON list of configured authentication providers.</description>
      <required>False</required>
    </field>
    <value />
  </record>

  <!-- Where the provider sends the user back. This is a route in the Volto
       frontend, not a backend view: the frontend reads code and state off the
       query string and POSTs them to @identity-callback. It is also the exact
       string registered with the provider as the redirect URI, so it cannot
       be guessed from the portal URL. -->
  <record name="pas.plugins.identity.callback_url">
    <field type="plone.registry.field.TextLine">
      <title>Login callback URL</title>
      <description>Absolute URL of the frontend route the provider redirects to after login, for example https://example.com/login-identity. Must match the redirect URI registered with every provider.</description>
      <required>False</required>
    </field>
    <value />
  </record>

  <!-- Audit log retention (D7). PII is opt-in and off. -->
  <record name="pas.plugins.identity.audit_max_entries">
    <field type="plone.registry.field.Int">
      <title>Audit entries kept per user</title>
    </field>
    <value>500</value>
  </record>

  <record name="pas.plugins.identity.audit_max_days">
    <field type="plone.registry.field.Int">
      <title>Audit retention in days</title>
    </field>
    <value>180</value>
  </record>

  <record name="pas.plugins.identity.audit_record_pii">
    <field type="plone.registry.field.Bool">
      <title>Record IP address and user agent</title>
      <description>Off by default. Enabling this stores personal data; see the privacy notes in the documentation.</description>
    </field>
    <value>False</value>
  </record>

</registry>
