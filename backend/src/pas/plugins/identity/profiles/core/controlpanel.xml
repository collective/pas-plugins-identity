<?xml version="1.0" encoding="utf-8"?>
<object xmlns:i18n="http://xml.zope.org/namespaces/i18n"
        name="portal_controlpanel"
        purge="False"
        i18n:domain="pas.plugins.identity"
>

  <!-- What makes the panel appear in the control panel listing and in
       @controlpanels. The frontend routes ``@controlpanels`` entries by
       their id, so it renders its own panel at
       /controlpanel/identity-providers; ``url_expr`` is what Classic UI
       follows, and points at the plain registry form. -->
  <configlet action_id="identity-providers"
             appId="pas.plugins.identity"
             category="plone-users"
             condition_expr=""
             icon_expr="string:id-card"
             title="Identity providers"
             url_expr="string:${portal_url}/@@identity-controlpanel"
             visible="True"
             i18n:attributes="title"
  >
    <permission>Manage portal</permission>
  </configlet>

</object>
