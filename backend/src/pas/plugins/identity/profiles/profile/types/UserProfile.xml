<?xml version="1.0" encoding="utf-8"?>
<object xmlns:i18n="http://xml.zope.org/namespaces/i18n"
        meta_type="Dexterity FTI"
        name="UserProfile"
        i18n:domain="pas.plugins.identity"
>
  <property name="title"
            i18n:translate=""
  >User Profile</property>
  <property name="description"
            i18n:translate=""
  >Content-backed profile for one Plone user.</property>
  <property name="allowed_content_types" />
  <property name="filter_content_types">True</property>
  <!-- Addable anywhere, but only by someone holding
       ``pas.plugins.identity: Add Profile`` — Manager and Site
       Administrator per rolemap.xml. A permission is the right lock here
       and a structural one is not: with ``global_allow`` false a Profile
       cannot be pasted into an ordinary folder at all, which would make
       reorganising content silently impossible for the administrator who
       is allowed to do everything else. -->
  <property name="global_allow">True</property>
  <property name="icon_expr">string:person</property>
  <property name="klass">pas.plugins.identity.content.profile.UserProfile</property>
  <property name="schema">pas.plugins.identity.content.profile.IUserProfileSchema</property>
  <property name="add_permission">pas.plugins.identity.content.add</property>
  <property name="link_target" />
  <property name="model_source" />
  <property name="model_file" />

  <!-- Deliberately short. The claims-sync subscriber and the PAS
       property sheet (6b) are the consumers of this type; the standard
       Dublin Core behaviors would add metadata nobody serves, and every
       behavior field is a field the churn test has to keep consistent.

       plone.namefromtitle is absent on purpose: Title() here is computed
       from the full name, which is neither unique nor stable, and every
       Profile is created with an explicit id (the canonical userid). -->
  <property name="behaviors">
    <element value="plone.shortname" />
  </property>

  <alias from="(Default)"
         to="(dynamic view)"
  />
  <alias from="edit"
         to="@@edit"
  />
  <alias from="sharing"
         to="@@sharing"
  />
  <alias from="view"
         to="(selected layout)"
  />

  <action action_id="view"
          category="object"
          condition_expr=""
          title="View"
          url_expr="string:${object_url}"
          visible="True"
          i18n:attributes="title"
  >
    <permission value="View" />
  </action>
  <action action_id="edit"
          category="object"
          condition_expr=""
          title="Edit"
          url_expr="string:${object_url}/edit"
          visible="True"
          i18n:attributes="title"
  >
    <permission value="Modify portal content" />
  </action>
</object>
