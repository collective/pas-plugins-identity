<?xml version="1.0" encoding="utf-8"?>
<!-- Removes this package's own personal_tools entries and gives Volto's
     profile entry back the condition plone.volto declares, which no longer
     calls this package's view. The entries plone.volto shares stay: they
     are Volto's menu, not this package's. -->
<object meta_type="Plone Actions Tool"
        name="portal_actions"
>
  <object meta_type="CMF Action Category"
          name="personal_tools"
  >
    <object meta_type="CMF Action"
            name="profile"
    >
      <property name="available_expr">python:member is not None</property>
    </object>
    <object meta_type="CMF Action"
            name="identity_profile"
            remove="True"
    />
    <object meta_type="CMF Action"
            name="identities"
            remove="True"
    />
  </object>
</object>
