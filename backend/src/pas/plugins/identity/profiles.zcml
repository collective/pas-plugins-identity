<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="pas.plugins.identity"
    >

  <genericsetup:registerProfile
      name="default"
      title="pas.plugins.identity: Install"
      description="Multi-provider external authentication for Plone, with users and groups as content."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/default"
      post_handler=".setuphandlers.post_install"
      />

  <!-- A profile rather than a site-wide import step. An import step is
       registered once for the whole site and runs during *every* add-on
       installation, so keeping it from clearing an innocent catalog needed
       a marker file in the profile directory and a guard reading it. A
       profile runs when somebody applies it and never otherwise, which is
       the behaviour that guard was reconstructing. -->
  <genericsetup:registerProfile
      name="rebuild-catalog"
      title="pas.plugins.identity: Rebuild the user catalog"
      description="Clear the dedicated user catalog and index every user profile in the site again. Re-runnable, and safe to run at any time."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/rebuild-catalog"
      post_handler=".setuphandlers.rebuild_catalog"
      />

  <genericsetup:registerProfile
      name="uninstall"
      title="pas.plugins.identity: Uninstall"
      description="Uninstall pas.plugins.identity setup."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/uninstall"
      post_handler=".setuphandlers.post_uninstall"
      />

  <!-- Hide the uninstall profiles of both layers. One utility is enough: the
       add-ons control panel collects every INonInstallable it can find and
       merges what they hide, so the name this is registered under has nothing
       to do with which package a hidden profile is in. -->
  <utility
      factory=".setuphandlers.HiddenProfiles"
      name="pas.plugins.identity"
      />

  <!-- GenericSetup for the dedicated Profile catalog.

       The adapter is a one line subclass of the stock ZCatalog one, which is
       registered for IZCatalog and so already adapts our tool; all it changes
       is the filename. This registration is the more specific of the two, so
       it wins for this catalog and leaves every other one alone.

       The steps exist because CMFCore's resolve their target with
       queryUtility(ICatalogTool), which answers portal_catalog and nothing
       else. Depends on toolset, which is what creates the tool: without the
       ordering the step would run against a site that has no catalog yet and
       quietly do nothing. -->
  <adapter factory=".setuphandlers.catalogxml.IdentityCatalogXMLAdapter" />

  <genericsetup:importStep
      name="identity-catalog"
      title="Identity Profile Catalog"
      description="Import the dedicated user catalog's indexes, columns and lexicon."
      handler=".setuphandlers.catalogxml.import_identity_catalog"
      >
    <depends name="toolset" />
  </genericsetup:importStep>

  <genericsetup:exportStep
      name="identity-catalog"
      title="Identity Profile Catalog"
      description="Export the dedicated user catalog's indexes, columns and lexicon."
      handler=".setuphandlers.catalogxml.export_identity_catalog"
      />

  <include package=".upgrades" />

</configure>
