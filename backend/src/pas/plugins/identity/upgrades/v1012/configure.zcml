<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    >

  <!-- Naming the headers that carry the client's address. See the module
       docstring. -->
  <genericsetup:upgradeSteps
      profile="pas.plugins.identity:default"
      source="1011"
      destination="1012"
      >
    <genericsetup:upgradeStep
        title="Add the client address headers setting"
        description="Creates the client_ip_headers registry record, empty, keeping every existing setting's value."
        handler=".add_client_ip_headers"
        />
  </genericsetup:upgradeSteps>

</configure>
