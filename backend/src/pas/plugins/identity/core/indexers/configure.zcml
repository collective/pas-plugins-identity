<configure
    xmlns="http://namespaces.zope.org/zope"
    i18n_domain="pas.plugins.identity"
    >

  <!-- Catalog maintenance. Registered for the marker rather than for the
       portal type, so an object of a site's own type that claims the marker
       is filed the same way. ``query_catalog`` answers None in a site that
       does not have this add-on installed, which is what keeps these inert
       there: the subscribers are registered instance-wide, and other sites in
       the same Zope have never heard of us. -->
  <subscriber
      for="..interfaces.IIdentityCatalogued
           zope.lifecycleevent.interfaces.IObjectMovedEvent"
      handler=".profile_moved"
      />

  <subscriber
      for="..interfaces.IIdentityCatalogued
           OFS.interfaces.IObjectWillBeMovedEvent"
      handler=".profile_will_be_moved"
      />

  <subscriber
      for="..interfaces.IIdentityCatalogued
           zope.lifecycleevent.interfaces.IObjectModifiedEvent"
      handler=".profile_modified"
      />

  <!-- A transition changes review_state, which is both an index and a
       metadata column, and fires no modification event of its own. -->
  <subscriber
      for="..interfaces.IIdentityCatalogued
           Products.DCWorkflow.interfaces.IAfterTransitionEvent"
      handler=".profile_modified"
      />

  <!-- Both indexers fold or narrow what the field literally holds; see the
       module for why. -->
  <adapter
      factory=".login_index"
      name="login"
      />

  <adapter
      factory=".searchable_text_index"
      name="SearchableText"
      />

</configure>
