<configure
    xmlns="http://namespaces.zope.org/zope"
    i18n_domain="pas.plugins.identity"
    >

  <include package=".audit" />
  <include package=".behaviors" />
  <include package=".contents" />
  <include package=".controlpanel" />
  <include package=".drivers" />
  <include package=".indexers" />
  <include package=".pas" />
  <include package=".serializers" />
  <include package=".services" />
  <include package=".subscribers" />
  <include package=".vocabularies" />

  <include package=".browser" />

  <!-- A user may edit their own Profile and nobody else's. Computed rather
       than assigned, so there is nothing to keep in step. -->
  <adapter factory=".localroles.ProfileSelfRole" />

</configure>
