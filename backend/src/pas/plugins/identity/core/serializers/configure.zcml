<configure
    xmlns="http://namespaces.zope.org/zope"
    i18n_domain="pas.plugins.identity"
    >

  <!-- What `@users` says about a user once this package is installed: the
       identities linked, the plugin the userid came from, and the Profile.
       On our own browser layer, so a site that has not installed this package
       is untouched. -->
  <adapter factory=".user.SerializeIdentityUserToJson" />

  <!-- One row of `@group-members`, built from a Profile brain alone. Adapts
       the site rather than the brain: a brain has no `__provides__` and so
       cannot be marked, and a registration for `ICatalogBrain` would answer
       for every brain in the site. As a summary that would shadow
       plone.restapi's own default and take over search results. -->
  <adapter factory=".groupmember.GroupMemberSerializer" />

</configure>
