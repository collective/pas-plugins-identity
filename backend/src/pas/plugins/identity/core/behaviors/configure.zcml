<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="pas.plugins.identity"
    >

  <!-- Off unless a site enables it on a type. Without it a new user's
       password goes to source_users, which is where Plone has always kept
       one. See .password for the four ways a Dexterity field holding a
       credential leaks it, and why the hash is an annotation. -->
  <plone:behavior
      name="pas.plugins.identity.password"
      title="Password storage"
      description="Keep this user's password on the object rather than in source_users."
      factory=".password.PasswordStorage"
      provides="..interfaces.ICredentialStorage"
      for="..interfaces.IUserContent"
      />

  <subscriber
      for="..interfaces.IUserContent
           zope.lifecycleevent.interfaces.IObjectCopiedEvent"
      handler=".password.clear_on_copy"
      />

  <!-- Group membership. A schema-only behavior, so its one field is stored
       on the content object exactly as a declared field was: the Profile
       still answers ``profile.group_ids`` and the catalog still indexes it.
       Enabled on the Group type as well, where the same field means the
       groups that *group* is in. See ..utils.nesting for why membership stays
       a fact stored on the member, whether the member is a person or a
       group. -->
  <plone:behavior
      name="pas.plugins.identity.group_membership"
      title="Group membership"
      description="The groups this principal belongs to."
      provides=".membership.IGroupMembership"
      />

  <!-- A person's addresses. Schema only, so the list is stored on the content
       object exactly as a declared field was, and the class properties on
       UserProfile are still what normalizes a write and derives the single
       value. Its own fieldset, because these are the fields carrying the
       viewpii read permission rather than the ordinary one. -->
  <plone:behavior
      name="pas.plugins.identity.email_addresses"
      title="Email addresses"
      description="The addresses this person is reached and recognised by."
      provides=".email.IEmailAddresses"
      />

  <!-- What a person says about themselves, and their picture. Schema only,
       and with no fieldset of its own: these belong beside the login and the
       full name on the default tab. -->
  <plone:behavior
      name="pas.plugins.identity.profile_details"
      title="Profile details"
      description="Home page, location and picture."
      provides=".details.IProfileDetails"
      />

</configure>
