<configure
    xmlns="http://namespaces.zope.org/zope"
    i18n_domain="pas.plugins.identity"
    >

  <!-- Drivers are named utilities; the name is the driver_id. -->
  <utility
      factory=".github.GitHubDriver"
      provides="pas.plugins.identity.core.interfaces.IDriver"
      name="github"
      />

  <utility
      factory=".google.GoogleDriver"
      provides="pas.plugins.identity.core.interfaces.IDriver"
      name="google"
      />

  <utility
      factory=".oidc.GenericOIDCDriver"
      provides="pas.plugins.identity.core.interfaces.IDriver"
      name="oidc-generic"
      />

  <utility
      factory=".emaillink.EmailDriver"
      provides="pas.plugins.identity.core.interfaces.IDriver"
      name="email"
      />

</configure>
