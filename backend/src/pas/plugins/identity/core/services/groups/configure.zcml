<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="pas.plugins.identity"
    >

  <!-- A group's own members, resolved through the nesting and answered from
       the Profile catalog. Authenticated-only, checked in the service so the
       refusal is a JSON body rather than a login form; who may read which
       group is decided there too. -->
  <plone:service
      method="GET"
      factory=".get.GroupMembersGet"
      for="Products.CMFCore.interfaces.ISiteRoot"
      permission="zope2.View"
      layer="pas.plugins.identity.interfaces.IBrowserLayer"
      name="@group-members"
      />

</configure>
