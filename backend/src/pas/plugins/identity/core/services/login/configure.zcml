<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="pas.plugins.identity"
    >

  <!-- The same listing, offered to anything that expands components.
       Anonymous like the endpoint: this is the login page's data. -->
  <adapter
      factory=".expander.LoginProviders"
      name="login-providers"
      />

  <plone:service
      method="GET"
      factory=".get.LoginProviders"
      for="Products.CMFCore.interfaces.ISiteRoot"
      permission="zope.Public"
      layer="pas.plugins.identity.interfaces.IBrowserLayer"
      name="@login-providers"
      />

</configure>
