<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="pas.plugins.identity"
    >

  <!-- Anonymous by design on both halves: the point is to log somebody in
       who has no other way to prove who they are. What guards them is the
       rate limiter and the signed, single-use, short-lived token. -->
  <plone:service
      method="POST"
      factory=".post.MagicLinkSend"
      for="Products.CMFCore.interfaces.ISiteRoot"
      permission="zope2.View"
      layer="pas.plugins.identity.interfaces.IBrowserLayer"
      name="@magic-link"
      />

  <plone:service
      method="POST"
      factory=".confirm.MagicLinkConfirm"
      for="Products.CMFCore.interfaces.ISiteRoot"
      permission="zope2.View"
      layer="pas.plugins.identity.interfaces.IBrowserLayer"
      name="@magic-link-confirm"
      />

</configure>
