<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="pas.plugins.identity"
    >

  <!-- Listing and flow start. Anonymous by design: this is the login page.
       No secrets and no provider configuration leave here (I4). -->
  <plone:service
      method="GET"
      factory=".login.LoginProviders"
      for="Products.CMFCore.interfaces.ISiteRoot"
      permission="zope2.View"
      layer="pas.plugins.identity.interfaces.IBrowserLayer"
      name="@login-providers"
      />

  <!-- The callback. Also anonymous: the whole point is that nobody is
       logged in yet. What authorizes the request is the single-use state
       bound to the signed flow cookie (S1). -->
  <plone:service
      method="POST"
      factory=".callback.IdentityCallback"
      for="Products.CMFCore.interfaces.ISiteRoot"
      permission="zope2.View"
      layer="pas.plugins.identity.interfaces.IBrowserLayer"
      name="@identity-callback"
      />

  <!-- Your own external identities (Gate 2). Authenticated-only, checked in
       the service so the refusal is a JSON body rather than a login form. -->
  <plone:service
      method="GET"
      factory=".identities.IdentitiesGet"
      for="Products.CMFCore.interfaces.ISiteRoot"
      permission="zope2.View"
      layer="pas.plugins.identity.interfaces.IBrowserLayer"
      name="@identities"
      />

  <plone:service
      method="POST"
      factory=".identities.IdentitiesPost"
      for="Products.CMFCore.interfaces.ISiteRoot"
      permission="zope2.View"
      layer="pas.plugins.identity.interfaces.IBrowserLayer"
      name="@identities"
      />

  <plone:service
      method="DELETE"
      factory=".identities.IdentitiesDelete"
      for="Products.CMFCore.interfaces.ISiteRoot"
      permission="zope2.View"
      layer="pas.plugins.identity.interfaces.IBrowserLayer"
      name="@identities"
      />

  <!-- Magic link (Gate 3, S5). Anonymous by design on both halves: the
       point is to log somebody in who has no other way to prove who they
       are. What guards them is the rate limiter and the signed, single-use,
       short-lived token. -->
  <plone:service
      method="POST"
      factory=".magiclink.MagicLinkSend"
      for="Products.CMFCore.interfaces.ISiteRoot"
      permission="zope2.View"
      layer="pas.plugins.identity.interfaces.IBrowserLayer"
      name="@magic-link"
      />

  <plone:service
      method="POST"
      factory=".magiclink.MagicLinkConfirm"
      for="Products.CMFCore.interfaces.ISiteRoot"
      permission="zope2.View"
      layer="pas.plugins.identity.interfaces.IBrowserLayer"
      name="@magic-link-confirm"
      />

  <!-- The authentication event log (Gate 4). Authenticated-only; reading
       beyond your own entries additionally needs Manage portal, checked in
       the service. -->
  <plone:service
      method="GET"
      factory=".auditlog.AuditLogGet"
      for="Products.CMFCore.interfaces.ISiteRoot"
      permission="zope2.View"
      layer="pas.plugins.identity.interfaces.IBrowserLayer"
      name="@audit-log"
      />

  <!-- Provider configuration (Gate 5, §4.5). Registered for View and
       guarded on Manage portal inside the services, so a caller without it
       gets a JSON refusal rather than a login form. -->
  <plone:service
      method="GET"
      factory=".providers.DriversGet"
      for="Products.CMFCore.interfaces.ISiteRoot"
      permission="zope2.View"
      layer="pas.plugins.identity.interfaces.IBrowserLayer"
      name="@identity-drivers"
      />

  <plone:service
      method="GET"
      factory=".providers.ProvidersGet"
      for="Products.CMFCore.interfaces.ISiteRoot"
      permission="zope2.View"
      layer="pas.plugins.identity.interfaces.IBrowserLayer"
      name="@identity-providers"
      />

  <plone:service
      method="POST"
      factory=".providers.ProvidersPost"
      for="Products.CMFCore.interfaces.ISiteRoot"
      permission="zope2.View"
      layer="pas.plugins.identity.interfaces.IBrowserLayer"
      name="@identity-providers"
      />

  <plone:service
      method="PATCH"
      factory=".providers.ProvidersPatch"
      for="Products.CMFCore.interfaces.ISiteRoot"
      permission="zope2.View"
      layer="pas.plugins.identity.interfaces.IBrowserLayer"
      name="@identity-providers"
      />

  <plone:service
      method="DELETE"
      factory=".providers.ProvidersDelete"
      for="Products.CMFCore.interfaces.ISiteRoot"
      permission="zope2.View"
      layer="pas.plugins.identity.interfaces.IBrowserLayer"
      name="@identity-providers"
      />

</configure>
