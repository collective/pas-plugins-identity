<configure xmlns="http://namespaces.zope.org/zope">

  <!-- Adding a user or a group is not an authoring action: they are minted by
       the first-login machinery and otherwise managed by administrators.

       The field permissions below still have ids under
       ``pas.plugins.identity.content``, from when that was a layer. They are
       stored in every site's rolemap, on every FTI and in both workflow
       definitions, so renaming them would be a migration that buys a nicer
       string. What they name is a content object, which is what a user is
       here, so they are not inaccurate either.

       One per type rather than one for both. They are granted on the
       container each type is filed in, and a site that files groups
       separately from users would otherwise have to grant both permissions
       in both places, which is a lock whose two halves cannot be moved
       independently, and so not a lock at all. -->
  <permission
      id="pas.plugins.identity.userprofile.add"
      title="pas.plugins.identity: Add User Profile"
      />

  <permission
      id="pas.plugins.identity.usergroup.add"
      title="pas.plugins.identity: Add User Group"
      />

  <!-- Deciding where principals are filed is an administrator's
       decision, like adding the principals themselves, and not an
       authoring action. The generic Folder add permission is held by
       every Contributor, which is why the Principals folder has one of
       its own. -->
  <permission
      id="pas.plugins.identity.principalscontainer.add"
      title="pas.plugins.identity: Add Principals Container"
      />

  <permission
      id="pas.plugins.identity.content.edit"
      title="pas.plugins.identity: Edit Profile"
      />

  <!-- Group membership is not a field its owner may write.
       ``group_ids`` is what grants a user their roles, so a user who can edit
       it on their own profile can put themselves in any group on the site.
       The ordinary edit permission is exactly what the owner of a profile
       holds, which made self-service and self-promotion the same action. -->
  <permission
      id="pas.plugins.identity.content.editgroups"
      title="pas.plugins.identity: Edit Profile Group Membership"
      />

  <!-- A login is not a field its owner may rewrite, and not one a Site
       Administrator may rewrite either.

       It is half of the case folded index user enumeration queries, so
       changing it moves an account: every sign in, every Sharing entry
       written against the old name, and every provider that maps a user by
       it. The ordinary edit permission is what the owner of a Profile holds,
       which made "correct my name" and "become somebody else" the same
       action.

       Only after creation, which is where the split lives rather than in
       this declaration. The container grants this permission alongside the
       add permission, so the add form still offers the field to whoever may
       file a principal there; the workflow grants it to Manager alone in
       every state, and the workflow is what governs the object once it
       exists. See core.container.LOGIN_ROLES. -->
  <permission
      id="pas.plugins.identity.content.editlogin"
      title="pas.plugins.identity: Edit Profile Login"
      />

  <!-- A group's global roles are not a field an ordinary editor may write,
       and not one a Site Administrator may write either.

       ``group_ids`` decides who is in a group; this decides what the group
       is allowed to do, which is one step further along the same path. Anyone
       able to write it could grant the group ``Manager`` and then add
       themselves to the group, so the ordinary edit permission would make
       "tidy up a group" and "become an administrator" the same action.

       Manager alone, which is stricter than the membership permission beside
       it. Delegating group *membership* to a Site Administrator is a normal
       arrangement; delegating the power to mint administrators is not. -->
  <permission
      id="pas.plugins.identity.content.editroles"
      title="pas.plugins.identity: Edit Group Global Roles"
      />

  <permission
      id="pas.plugins.identity.content.view"
      title="pas.plugins.identity: View Profile"
      />

  <permission
      id="pas.plugins.identity.content.viewpii"
      title="pas.plugins.identity: View Personal Identifiable Information"
      />

  <!-- Exporting the providers is not managing them.

       An export is a backup of the provider records, and a backup that left
       the client secrets out would restore providers unable to authenticate,
       so every export carries them in the clear. Managing a provider never
       needs its secret: the control panel and the rest of the API only send
       the mask. Under the permission that guards the rest of the control
       panel, "configure a provider" and "read every client secret" would be
       the same action.

       Manager alone. ``Manage portal`` is Manager's alone on a default site
       as well; this is separate so that a site giving another role the
       control panel does not give it every client secret along with it. -->
  <permission
      id="pas.plugins.identity.providers.export"
      title="pas.plugins.identity: Export Identity Providers"
      />

</configure>
