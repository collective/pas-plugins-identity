<configure xmlns="http://namespaces.zope.org/zope">

  <!-- Adding a user or a group is not an authoring action: they are minted by
       the first-login machinery and otherwise managed by administrators.

       The field permissions below still have ids under
       ``pas.plugins.identity.content``, from when that was a layer. They are
       stored in every site's rolemap, on every FTI and in both workflow
       definitions, so renaming them would be a migration that buys a nicer
       string. What they name is a content object, which is what a user is
       here, so they are not inaccurate either.

       One per type rather than one for both. They are granted on the
       container each type is filed in, and a site that files groups
       separately from users would otherwise have to grant both permissions
       in both places, which is a lock whose two halves cannot be moved
       independently, and so not a lock at all. -->
  <permission
      id="pas.plugins.identity.userprofile.add"
      title="pas.plugins.identity: Add User Profile"
      />

  <permission
      id="pas.plugins.identity.usergroup.add"
      title="pas.plugins.identity: Add User Group"
      />

  <permission
      id="pas.plugins.identity.content.edit"
      title="pas.plugins.identity: Edit Profile"
      />

  <!-- Group membership is not a field its owner may write.
       ``group_ids`` is what grants a user their roles, so a user who can edit
       it on their own profile can put themselves in any group on the site.
       The ordinary edit permission is exactly what the owner of a profile
       holds, which made self-service and self-promotion the same action. -->
  <permission
      id="pas.plugins.identity.content.editgroups"
      title="pas.plugins.identity: Edit Profile Group Membership"
      />

  <permission
      id="pas.plugins.identity.content.view"
      title="pas.plugins.identity: View Profile"
      />

  <permission
      id="pas.plugins.identity.content.viewpii"
      title="pas.plugins.identity: View Personal Identifiable Information"
      />

</configure>
