#: pas/plugins/identity/core/drivers/settings.py:375
msgid "The realm's URL, https://<server>/realms/<realm> -- not the server root, which serves no discovery document."
msgstr ""

#: pas/plugins/identity/core/behaviors/configure.zcml:63
msgid "The site-wide roles this group grants its members."
msgstr ""

#: pas/plugins/identity/profiles/default/workflows/user_profile_workflow/definition.xml
msgid "The user has filled in their profile."
msgstr ""

#: pas/plugins/identity/profiles/default/workflows/user_profile_workflow/definition.xml
msgid "The user has filled the profile in. Visible to authenticated members, which is what makes a Sharing-tab search useful."
msgstr ""

#: pas/plugins/identity/core/drivers/settings.py:181
msgid "This provider sends verification flags as text"
msgstr ""

