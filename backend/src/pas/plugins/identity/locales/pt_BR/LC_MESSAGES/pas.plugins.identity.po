msgstr "Os tokens de atualização são rotacionados a cada uso, então é assim que um cliente pode ficar ausente antes de um humano ter que entrar novamente."

#: pas/plugins/identity/server/interfaces.py:129
msgid "Registered OAuth clients"
msgstr "Clientes OAuth registrados"

#: pas/plugins/identity/server/profiles.zcml:29
