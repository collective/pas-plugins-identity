#: pas/plugins/identity/profiles/default/types/PrincipalsContainer.xml
msgid "A folder of user profiles and groups."
msgstr "Ein Ordner von Benutzerprofilen und Gruppen."

#: pas/plugins/identity/profiles/default/types/UserGroup.xml
msgid "A group, backed by content. Membership is a field on each Profile, not a list here."
msgstr "Eine Gruppe, deren Backup durch Inhalte erfolgt. Die Mitgliedschaft ist ein Feld in jedem Profil, nicht eine Liste hier."

#: pas/plugins/identity/core/drivers/settings.py:57
msgid "A random id"
msgstr "Eine Zufalls-ID"

#: pas/plugins/identity/server/controlpanel/interfaces.py:282
msgid "A redirect URI cannot be empty."
msgstr "Eine Umleitungs-URI darf nicht leer sein."

#: pas/plugins/identity/server/controlpanel/interfaces.py:287
msgid "A redirect URI may not carry a fragment."
msgstr "Eine Umleitungs-URI darf kein Fragment enthalten."

#: pas/plugins/identity/server/controlpanel/interfaces.py:131
msgid "A redirect URI may not use a wildcard in its port."
msgstr "Eine Umleitungs-URI darf keinen Platzhalter in ihrem Port verwenden."

#: pas/plugins/identity/server/controlpanel/interfaces.py:197
msgid "A redirect URI may not use a wildcard in its query string."
msgstr "Eine Umleitungs-URI darf keinen Platzhalter in ihrer Abfragezeichenfolge verwenden."

#: pas/plugins/identity/server/controlpanel/interfaces.py:128
msgid "A redirect URI may not use a wildcard with a user name."
msgstr "Eine Umleitungs-URI darf keinen Platzhalter mit einem Benutzernamen verwenden."

#: pas/plugins/identity/server/controlpanel/interfaces.py:142
msgid "A redirect URI may use only one host wildcard."
msgstr "Eine Umleitungs-URI darf nur einen Host-Platzhalter verwenden."

#: pas/plugins/identity/server/controlpanel/interfaces.py:171
msgid "A redirect URI may use only one path wildcard."
msgstr "Eine Umleitungs-URI darf nur einen Pfad-Platzhalter verwenden."

#: pas/plugins/identity/server/controlpanel/interfaces.py:285
msgid "A redirect URI must be absolute, with a scheme."
msgstr "Eine Umleitungs-URI muss absolut sein und ein Schema haben."

#: pas/plugins/identity/server/controlpanel/interfaces.py:293
msgid "A redirect URI must name a host."
msgstr "Eine Umleitungs-URI muss einen Host benennen."

#: pas/plugins/identity/server/controlpanel/interfaces.py:306
msgid "A redirect URI must use https, a loopback address, or a private-use scheme such as com.example.app:/callback."
msgstr "Eine Umleitungs-URI muss HTTPS, eine Loopback-Adresse oder ein privates Schema wie com.example.app:/callback verwenden."

#: pas/plugins/identity/server/controlpanel/interfaces.py:135
msgid "A wildcard host must be the whole leftmost label, as in https://*.example.com/callback."
msgstr "Ein Platzhalter-Host muss das gesamte linke Label sein, wie in https://*.example.com/callback."

#: pas/plugins/identity/server/controlpanel/interfaces.py:146
msgid "A wildcard host needs a registered domain under it, as in https://*.example.com/callback."
msgstr "Ein Platzhalter-Host braucht eine registrierte Domäne darunter, wie in https://*.example.com/callback."

#: pas/plugins/identity/server/controlpanel/interfaces.py:165
msgid "A wildcard path must be the whole last segment, as in https://example.com/app/*."
msgstr "Ein Platzhalter-Pfad muss das ganze letzte Segment sein, wie in https://example.com/app/*."

#: pas/plugins/identity/server/interfaces.py:190
msgid "Access token lifetime (seconds)"
msgstr "Zugriffstoken-Lebensdauer (Sekunden)"

#: pas/plugins/identity/server/interfaces.py:191
msgid "Access tokens are self-encoded and there is no denylist, so this is also the worst-case window between a revocation and the last token honouring it."
msgstr "Zugriffstokens sind selbst codiert und es gibt keine Sperrliste, daher ist dies auch das Worst-Case-Fenster zwischen einer Sperrung und dem letzten Token, der sie berücksichtigt."

#: pas/plugins/identity/core/drivers/settings.py:120
msgid "Accounts"
msgstr "Konten"

#: pas/plugins/identity/profiles/default/workflows/user_group_workflow/definition.xml
msgid "Active"
msgstr "Aktiv"

#: pas/plugins/identity/server/controlpanel/interfaces.py:401
msgid "Acts as"
msgstr "Fungiert als"

#: pas/plugins/identity/core/drivers/settings.py:325
msgid "Address preference"
msgstr "Adressenpräferenz"

#: pas/plugins/identity/core/drivers/settings.py:296
msgid "Allow the avatar to be fetched over plain HTTP"
msgstr "Erlauben Sie dem Avatar, über einfaches HTTP abgerufen zu werden"

#: pas/plugins/identity/core/drivers/settings.py:403
msgid "Also applied per requesting address. The endpoint answers identically whether or not the address belongs to an account, so this is what stops it being used to enumerate them."
msgstr "Auch pro Anforderungsadresse angewendet. Der Endpunkt antwortet identisch, unabhängig davon, ob die Adresse zu einem Konto gehört oder nicht, dies ist also das, was verhindert, dass sie aufgezählt wird."

#: pas/plugins/identity/core/controlpanel/interfaces.py:325
msgid "An SVG file. Empty means no icon, and the frontend then draws the title alone rather than a placeholder every provider shares."
msgstr "Eine SVG-Datei. Leer bedeutet kein Symbol, und das Frontend zeichnet dann nur den Titel, anstatt einen Platzhalter, den jeder Anbieter teilt."

#: pas/plugins/identity/core/controlpanel/interfaces.py:557
msgid "Ask a person with several verified addresses which one is theirs"
msgstr "Fragen Sie eine Person mit mehreren verifizierten Adressen, welche ihr gehört"

#: pas/plugins/identity/core/drivers/settings.py:197
msgid "Attach to an existing account with the same verified email"
msgstr "An ein bestehendes Konto mit derselben verifizierten E-Mail anhängen"

#: pas/plugins/identity/core/controlpanel/interfaces.py:199
msgid "Audit destinations"
msgstr "Audit-Ziele"

#: pas/plugins/identity/core/controlpanel/interfaces.py:175
msgid "Audit entries kept per user"
msgstr "Audit-Einträge pro Benutzer"

#: pas/plugins/identity/core/controlpanel/interfaces.py:239
msgid "Audit log"
msgstr "Audit-Protokoll"

#: pas/plugins/identity/core/controlpanel/interfaces.py:182
msgid "Audit retention in days"
msgstr "Audit-Aufbewahrung in Tagen"

#: pas/plugins/identity/core/controlpanel/interfaces.py:135
msgid "Avatar fetch timeout in seconds"
msgstr "Avatar-Abruf-Zeitüberschreitung in Sekunden"

#: pas/plugins/identity/core/controlpanel/interfaces.py:335
msgid "Background colour"
msgstr "Hintergrundfarbe"

#: pas/plugins/identity/core/contents/profile.py:94
msgid "Biography"
msgstr "Biografie"

#: pas/plugins/identity/profiles/default/workflows/user_profile_workflow/definition.xml
msgid "Bring a deactivated account back. It returns as incomplete rather than complete: whatever made it worth deactivating is worth reviewing."
msgstr "Bringen Sie ein deaktiviertes Konto zurück. Es wird als unvollständig zurückgegeben, anstatt vollständig: Das, das es wert gemacht hat, zu deaktivieren, ist es wert, überprüft zu werden."

#: pas/plugins/identity/profiles/default/workflows/user_group_workflow/definition.xml
msgid "Bring the group back, with the membership it always had."
msgstr "Bringen Sie die Gruppe zurück, mit der Mitgliedschaft, die sie schon immer hatte."

#: pas/plugins/identity/core/controlpanel/interfaces.py:386
msgid "Claim"
msgstr "Anspruch"

#: pas/plugins/identity/core/controlpanel/interfaces.py:380
msgid "Claim path to Profile field, applied on every login. One record rather than one per row: the keys are claim paths an operator types, so a record each would mean creating and deleting records as the map is edited."
msgstr "Anspruchspfad zum Profilfeld, angewendet bei jeder Anmeldung. Ein Datensatz statt einer pro Zeile: Die Schlüssel sind Anspruchspfade, die ein Operator eingeben kann, daher würde ein Datensatz pro Zeile bedeuten, dass Datensätze erstellt und gelöscht werden, wenn die Zuordnung bearbeitet wird."

#: pas/plugins/identity/profiles.zcml:29
msgid "Clear the dedicated user catalog and index every user profile in the site again. Re-runnable, and safe to run at any time."
msgstr "Löschen Sie den dedizierten Benutzerkatalog und indizieren Sie erneut jedes Benutzerprofil auf der Website. Wieder ausführbar und jederzeit sicher auszuführen."

#: pas/plugins/identity/core/drivers/settings.py:82
msgid "Client ID"
msgstr "Client-ID"

#: pas/plugins/identity/core/drivers/settings.py:88
msgid "Client secret"
msgstr "Client-Geheimnis"

#: pas/plugins/identity/profiles/default/workflows/user_group_workflow/definition.xml
#: pas/plugins/identity/profiles/default/workflows/user_profile_workflow/definition.xml
msgid "Comments about the last transition"
msgstr "Kommentare zum letzten Übergang"

#: pas/plugins/identity/profiles/default/workflows/user_profile_workflow/definition.xml
msgid "Complete"
msgstr "Vollständig"

#: pas/plugins/identity/server/interfaces.py:165
msgid "Consent screen URL"
msgstr "Zustimmungsbildschirm-URL"

#: pas/plugins/identity/profiles/default/types/UserProfile.xml
msgid "Content-backed profile for one Plone user."
msgstr "Inhaltsgestütztes Profil für einen Plone-Benutzer."

#: pas/plugins/identity/core/controlpanel/interfaces.py:121
msgid "Copy provider avatars into portrait storage"
msgstr "Kopieren Sie Avatar-Anbieter in den Porträt-Speicher"

#: pas/plugins/identity/core/controlpanel/interfaces.py:149
msgid "Counted off the stream rather than taken from a header, so a provider cannot understate it. This is a limit on what a user-supplied URL may make this site read into memory: raise it knowing that, and see the documentation on why avatar syncing is off by default."
msgstr "Von der Quelle gezählt, anstatt dem Header entnommen, kann ein Anbieter es also nicht unterschätzen. Dies ist eine Grenze dafür, was eine vom Benutzer bereitgestellte URL diese Website in den Speicher lesen lässt: Erhöhen Sie dies in dem Wissen und konsultieren Sie die Dokumentation darüber, warum die Avatar-Synchronisierung standardmäßig deaktiviert ist."

#: pas/plugins/identity/profiles.zcml:87
msgid "Create example content to showcase the new website"
msgstr "Erstellen Sie Beispielinhalte, um die neue Website zu präsentieren"

#: pas/plugins/identity/profiles/default/workflows/user_group_workflow/definition.xml
#: pas/plugins/identity/profiles/default/workflows/user_profile_workflow/definition.xml
msgid "Deactivate"
msgstr "Deaktivieren"

#: pas/plugins/identity/profiles/default/workflows/user_group_workflow/definition.xml
#: pas/plugins/identity/profiles/default/workflows/user_profile_workflow/definition.xml
msgid "Deactivated"
msgstr "Deaktiviert"

#: pas/plugins/identity/core/contents/group.py:70
msgid "Description"
msgstr "Beschreibung"

#: pas/plugins/identity/core/controlpanel/interfaces.py:209
msgid "Destination"
msgstr "Ziel"

#: pas/plugins/identity/core/drivers/settings.py:214
msgid "Discovery is fetched from <issuer>/.well-known/openid-configuration."
msgstr "Die Ermittlung wird von <issuer>/.well-known/openid-configuration abgerufen."

#: pas/plugins/identity/core/controlpanel/interfaces.py:284
msgid "Driver"
msgstr "Treiber"

#: pas/plugins/identity/profiles/default/types/PrincipalsContainer.xml
#: pas/plugins/identity/profiles/default/types/UserGroup.xml
#: pas/plugins/identity/profiles/default/types/UserProfile.xml
msgid "Edit"
msgstr "Bearbeiten"

#: pas/plugins/identity/core/behaviors/email.py:70
msgid "Email"
msgstr "E-Mail"

#: pas/plugins/identity/core/behaviors/configure.zcml:50
#: pas/plugins/identity/core/behaviors/email.py:75
msgid "Email addresses"
msgstr "E-Mail-Adressen"

#: pas/plugins/identity/core/controlpanel/interfaces.py:298
#: pas/plugins/identity/server/controlpanel/interfaces.py:349
msgid "Enabled"
msgstr "Aktiviert"

#: pas/plugins/identity/core/controlpanel/interfaces.py:183
msgid "Entries older than this are dropped."
msgstr "Einträge älter als dieser werden gelöscht."

#: pas/plugins/identity/core/controlpanel/interfaces.py:587
msgid "Enumeration-active group states"
msgstr "Aufzählungsaktive Gruppenzustände"

#: pas/plugins/identity/core/controlpanel/interfaces.py:516
msgid "Enumeration-active states"
msgstr "Aufzählungsaktive Zustände"

#: pas/plugins/identity/core/controlpanel/interfaces.py:531
msgid "Extra view names never redirected while a profile is incomplete, matched against the last segment of the path. The sign-in, sign-out and OAuth authorization endpoints are already exempt; this is for a browser-based flow another add-on publishes, which would otherwise be interrupted halfway."
msgstr "Zusätzliche Ansichtsnamen, die niemals umgeleitet werden, während ein Profil unvollständig ist, entsprechend dem letzten Pfadsegment. Die Anmeldungs-, Abmeldungs- und OAuth-Autorisierungsendpunkte sind bereits ausgenommen; dies ist für einen Browser-basierten Fluss, den ein anderes Add-on veröffentlicht, der ansonsten auf halbem Wege unterbrochen würde."

#: pas/plugins/identity/core/controlpanel/interfaces.py:573
msgid "Fields a user must fill in before their profile counts as complete. Empty means the fields the profile type itself marks required, which is the right answer for a site that has not thought about it and for a site with its own user type. Naming a field here that the type does not require will keep asking for something the edit form does not insist on."
msgstr "Felder, die ein Benutzer ausfüllen muss, bevor sein Profil als vollständig gilt. Leer bedeutet die Felder, die der Profiltyp selbst als erforderlich markiert, was die richtige Antwort für eine Website ist, die nicht darüber nachgedacht hat, und für eine Website mit ihrem eigenen Benutzertyp. Das Benennen eines Felds hier, das der Typ nicht erfordert, wird immer wieder nach etwas fragen, auf dem das Bearbeitungsformular nicht besteht."

#: pas/plugins/identity/server/controlpanel/interfaces.py:435
msgid "Flow"
msgstr "Fluss"

#: pas/plugins/identity/core/controlpanel/interfaces.py:346
msgid "Foreground colour"
msgstr "Vordergrundfarbe"

#: pas/plugins/identity/core/contents/profile.py:85
msgid "Full name"
msgstr "Vollständiger Name"

#: pas/plugins/identity/core/behaviors/configure.zcml:63
#: pas/plugins/identity/core/behaviors/roles.py:73
msgid "Global roles"
msgstr "Globale Rollen"

#: pas/plugins/identity/server/controlpanel/interfaces.py:374
msgid "Grants"
msgstr "Gewährungen"

#: pas/plugins/identity/core/controlpanel/interfaces.py:484
msgid "Group container id"
msgstr "Gruppen-Container-ID"

#: pas/plugins/identity/core/controlpanel/interfaces.py:474
msgid "Group container parent"
msgstr "Gruppen-Container-Übergeordnete"

#: pas/plugins/identity/core/controlpanel/interfaces.py:110
msgid "Group container path"
msgstr "Gruppenbehälter-Pfad"

#: pas/plugins/identity/core/controlpanel/interfaces.py:495
msgid "Group container title"
msgstr "Gruppenbehälter-Titel"

#: pas/plugins/identity/core/controlpanel/interfaces.py:505
msgid "Group container type"
msgstr "Gruppenbehälter-Typ"

#: pas/plugins/identity/core/controlpanel/interfaces.py:98
msgid "Group content type"
msgstr "Gruppen-Inhaltstyp"

#: pas/plugins/identity/core/controlpanel/interfaces.py:405
msgid "Group map"
msgstr "Gruppenzuordnung"

#: pas/plugins/identity/core/behaviors/configure.zcml:38
msgid "Group membership"
msgstr "Gruppenmitgliedschaft"

#: pas/plugins/identity/core/behaviors/membership.py:76
#: pas/plugins/identity/core/drivers/settings.py:262
msgid "Groups"
msgstr "Gruppen"

#: pas/plugins/identity/core/drivers/settings.py:226
msgid "Groups arrive in the claim"
msgstr "Gruppen kommen im Anspruch an"

#: pas/plugins/identity/core/controlpanel/interfaces.py:588
msgid "Groups in these workflow states are visible to group enumeration and grant membership."
msgstr "Gruppen in diesen Arbeitsablaufzuständen sind sichtbar für die Gruppenaufzählung und gewähren die Mitgliedschaft."

#: pas/plugins/identity/server/interfaces.py:201
msgid "Groups never released in a claim"
msgstr "Gruppen, die niemals in einem Anspruch freigegeben werden"

#: pas/plugins/identity/server/interfaces.py:202
msgid "Groups this site keeps to itself. A group named here is left out of the `groups` claim for every relying party, which is how an operations or on-call group stays a local matter. It does not change who is in the group, only what this server says about it."
msgstr "Gruppen, die diese Website für sich behält. Eine hier benannte Gruppe wird aus dem `groups`-Anspruch für jede vertrauende Partei ausgeschlossen, weshalb eine Operations- oder Bereitschaftsgruppe eine lokale Angelegenheit bleibt. Es ändert nicht, wer in der Gruppe ist, sondern nur, was dieser Server über sie sagt."

#: pas/plugins/identity/core/controlpanel/interfaces.py:544
msgid "Hold users on their profile until it is complete"
msgstr "Halten Sie Benutzer auf ihrem Profil, bis es vollständig ist"

#: pas/plugins/identity/core/behaviors/details.py:52
msgid "Home page"
msgstr "Startseite"

#: pas/plugins/identity/core/behaviors/configure.zcml:73
msgid "Home page, location and picture."
msgstr "Startseite, Standort und Bild."

#: pas/plugins/identity/core/drivers/settings.py:393
msgid "How long a link stays redeemable. Capped at fifteen minutes whatever is configured, and a token is burned after one use."
msgstr "Wie lange ein Link einlösbar bleibt. Auf 15 Minuten begrenzt, egal was konfiguriert ist, und ein Token wird nach einmaliger Verwendung gelöscht."

#: pas/plugins/identity/core/controlpanel/interfaces.py:136
msgid "How long to wait for a provider's avatar. This runs while somebody is waiting to log in, so the right number depends on where the provider is: a container on this host answers in milliseconds, a distant CDN may not. A fetch that times out is a missing picture, never a failed login."
msgstr "Wie lange auf den Avatar eines Anbieters zu warten. Dies läuft, während jemand auf die Anmeldung wartet, daher hängt die richtige Anzahl davon ab, wo sich der Anbieter befindet: Ein Container auf diesem Host antwortet in Millisekunden, ein entferntes CDN möglicherweise nicht. Ein Abruf, der ausläuft, ist ein fehlendes Bild, niemals eine fehlgeschlagene Anmeldung."

#: pas/plugins/identity/core/controlpanel/interfaces.py:162
msgid "How long to wait for a provider's metadata document. Separate from the avatar timeout because it fails differently: an avatar that does not arrive is a missing picture, while metadata that does not arrive is a login that cannot start."
msgstr "Wie lange auf das Metadatendokument eines Anbieters zu warten. Getrennt vom Avatar-Timeout, da es unterschiedlich fehlschlägt: Ein Avatar, der nicht ankommt, ist ein fehlendes Bild, während Metadaten, die nicht ankommen, eine Anmeldung sind, die nicht gestartet werden kann."

#: pas/plugins/identity/server/controlpanel/interfaces.py:424
msgid "How this client authenticates at the token endpoint. Decided by whether it was registered with a secret."
msgstr "Wie sich dieser Client am Token-Endpunkt authentifiziert. Entschieden danach, ob er mit einem Geheimnis registriert wurde."

#: pas/plugins/identity/core/controlpanel/interfaces.py:324
msgid "Icon"
msgstr "Symbol"

#: pas/plugins/identity/core/controlpanel/interfaces.py:285
msgid "Id of the driver that talks to this provider."
msgstr "ID des Treibers, der mit diesem Anbieter kommuniziert."

#: pas/plugins/identity/core/controlpanel/interfaces.py:485
msgid "Id of the folder holding groups. Empty means groups are filed with the profiles, which is what a site that has not thought about it wants."
msgstr "ID des Ordners mit Gruppen. Leer bedeutet, dass Gruppen mit den Profilen abgelegt werden, was eine Website möchte, die nicht darüber nachgedacht hat."

#: pas/plugins/identity/core/controlpanel/interfaces.py:447
msgid "Id of the folder holding user profiles."
msgstr "ID des Ordners mit Benutzerprofilen."

#: pas/plugins/identity/core/controlpanel/controlpanel.py:38
#: pas/plugins/identity/core/controlpanel/view.py:26
#: pas/plugins/identity/profiles/default/controlpanel.xml
msgid "Identity providers"
msgstr "Identitätsanbieter"

#: pas/plugins/identity/profiles/default/workflows/user_profile_workflow/definition.xml
msgid "Incomplete"
msgstr "Unvollständig"

#: pas/plugins/identity/core/drivers/settings.py:213
#: pas/plugins/identity/server/interfaces.py:152
msgid "Issuer URL"
msgstr "Aussteller-URL"

#: pas/plugins/identity/server/interfaces.py:130
msgid "JSON list of client registrations. Written through the control panel rather than by hand; client secrets are stored hashed and cannot be read back."
msgstr "JSON-Liste der Client-Registrierungen. Geschrieben über das Kontrollzentrum statt von Hand; Client-Geheimnisse werden gehashed gespeichert und können nicht zurückgelesen werden."

#: pas/plugins/identity/server/interfaces.py:141
msgid "JSON list of private JWKs, newest first. Generated when the server profile is applied and rotated from the control panel; never edited by hand. Only the public halves are published, as the JWKS relying parties fetch."
msgstr "JSON-Liste von privaten JWKs, neueste zuerst. Generiert, wenn das Serverprofil angewendet wird, und vom Kontrollzentrum aus rotiert; niemals von Hand bearbeitet. Nur die öffentlichen Hälften werden veröffentlicht, wie von JWKS-vertrauenden Parteien abgerufen."

#: pas/plugins/identity/core/behaviors/configure.zcml:18
msgid "Keep this user's password on the object rather than in source_users."
msgstr "Speichern Sie das Passwort dieses Benutzers auf dem Objekt anstatt in source_users."

#: pas/plugins/identity/core/controlpanel/interfaces.py:148
msgid "Largest avatar accepted, in bytes"
msgstr "Größter Avatar akzeptiert, in Bytes"

#: pas/plugins/identity/core/drivers/settings.py:241
msgid "Leave it empty and anybody this provider authenticates may sign in. Name groups here and a sign-in is refused unless the provider says the person is in one of them. An entry matches either a name the provider sends or a local group id the map turns one into, so it can be written in whichever vocabulary the policy is easier to state in. This needs a group claim: with none configured no groups arrive, and nobody matches."
msgstr "Lassen Sie es leer und jeder, den dieser Anbieter authentifiziert, kann sich anmelden. Benennen Sie hier Gruppen und eine Anmeldung wird verweigert, wenn der Anbieter nicht sagt, dass die Person in einer von ihnen ist. Ein Eintrag entspricht entweder einem Namen, den der Anbieter sendet, oder einer lokalen Gruppen-ID, die die Zuordnung in einen umwandelt, daher kann sie in jedem Vokabular geschrieben werden, in dem die Richtlinie einfacher auszudrücken ist. Dies erfordert einen Gruppenanspruch: Wenn keiner konfiguriert ist, kommen keine Gruppen an, und niemand stimmt überein."

#: pas/plugins/identity/core/drivers/settings.py:161
msgid "Let this provider create accounts"
msgstr "Lassen Sie diesen Anbieter Konten erstellen"

#: pas/plugins/identity/core/drivers/settings.py:276
msgid "Let this provider set group membership"
msgstr "Lassen Sie diesen Anbieter die Gruppenmitgliedschaft festlegen"

#: pas/plugins/identity/core/drivers/settings.py:392
msgid "Link lifetime (seconds)"
msgstr "Link-Lebensdauer (Sekunden)"

#: pas/plugins/identity/core/drivers/settings.py:402
msgid "Links per address per hour"
msgstr "Links pro Adresse pro Stunde"

#: pas/plugins/identity/core/controlpanel/interfaces.py:415
msgid "Local group"
msgstr "Lokale Gruppe"

#: pas/plugins/identity/core/behaviors/details.py:57
msgid "Location"
msgstr "Standort"

#: pas/plugins/identity/core/controlpanel/interfaces.py:227
msgid "Login"
msgstr "Anmeldung"

#: pas/plugins/identity/core/controlpanel/interfaces.py:48
msgid "Login callback URL"
msgstr "Anmeldungs-Rückruf-URL"

#: pas/plugins/identity/core/contents/profile.py:79
msgid "Login name"
msgstr "Anmeldungsname"

#: pas/plugins/identity/profiles/default/workflows/user_profile_workflow/definition.xml
msgid "Mark complete"
msgstr "Als vollständig markieren"

#: pas/plugins/identity/core/drivers/settings.py:198
msgid "Matches a verified address: one this site confirmed with a magic link, or one a provider it trusts confirmed. Needs this provider's own verification to be trusted too, since the address being matched on is the one it just sent."
msgstr "Entspricht einer verifizierten Adresse: einer, die diese Website mit einem magischen Link bestätigt hat, oder einer, die ein vertrauensvoller Anbieter bestätigt hat. Benötigt auch die eigene Verifizierung dieses Anbieters, um vertraut zu werden, da die abgeglichene Adresse die ist, die er gerade gesendet hat."

#: pas/plugins/identity/profiles.zcml:14
msgid "Multi-provider external authentication for Plone, with users and groups as content."
msgstr "Multi-Anbieter-externe Authentifizierung für Plone mit Benutzern und Gruppen als Inhalte."

#: pas/plugins/identity/server/controlpanel/interfaces.py:413
msgid "Never edited and never shown. The secret itself exists once, in the response that registered or rotated it."
msgstr "Niemals bearbeitet und niemals gezeigt. Das Geheimnis selbst existiert einmal in der Antwort, die es registriert oder rotiert hat."

#: pas/plugins/identity/server/controlpanel/panel.py:46
#: pas/plugins/identity/server/profiles/default/controlpanel.xml
msgid "OAuth clients"
msgstr "OAuth-Clients"

#: pas/plugins/identity/core/controlpanel/interfaces.py:190
msgid "Off by default. Enabling this stores personal data; see the privacy notes in the documentation."
msgstr "Standardmäßig deaktiviert. Das Aktivieren speichert persönliche Daten; siehe die Datenschutzhinweise in der Dokumentation."

#: pas/plugins/identity/core/controlpanel/interfaces.py:122
msgid "Off by default. When on, a changed picture_url claim is fetched over HTTPS on login and stored as the user's portrait. The URL is a claim, so at many providers it is whatever the user typed: enabling this makes the login path fetch an address the user chose. See the documentation before turning it on."
msgstr "Standardmäßig deaktiviert. Bei Aktivierung wird ein geänderter picture_url-Anspruch bei der Anmeldung über HTTPS abgerufen und als Porträt des Benutzers gespeichert. Die URL ist ein Anspruch, daher ist sie bei vielen Anbietern das, was der Benutzer eingegeben hat: Das Aktivieren führt dazu, dass der Anmeldungspfad eine vom Benutzer gewählte Adresse abruft. Konsultieren Sie die Dokumentation, bevor Sie es aktivieren."

#: pas/plugins/identity/core/controlpanel/interfaces.py:176
msgid "Older entries are dropped once a user passes this many."
msgstr "Ältere Einträge werden gelöscht, sobald ein Benutzer diese Anzahl überschreitet."

#: pas/plugins/identity/core/drivers/settings.py:98
msgid "One permission per entry. They are joined with spaces when the authorize URL is built, which is the encoding OAuth 2 defines -- a scope containing a space is not one scope."
msgstr "Eine Berechtigung pro Eintrag. Sie werden mit Leerzeichen verknüpft, wenn die Autorisierungs-URL erstellt wird, was die Kodierung ist, die OAuth 2 definiert -- ein Bereich, der ein Leerzeichen enthält, ist kein Bereich."

#: pas/plugins/identity/core/drivers/settings.py:297
msgid "Only for a provider on a network you control -- a demo or development stack with no certificate. Portrait syncing fetches a URL the provider supplies, and over plain HTTP that fetch can be aimed at an internal service and read back through the portrait. Leave this off for any provider on the public internet."
msgstr "Nur für einen Anbieter in einem Netz, das Sie kontrollieren -- ein Demo- oder Entwicklungs-Stack ohne Zertifikat. Die Portrait-Synchronisierung ruft eine URL ab, die der Anbieter liefert, und über einfaches HTTP kann dieser Abruf auf einen internen Dienst abzielen und über das Porträt zurückgelesen werden. Lassen Sie dies für jeden Anbieter im öffentlichen Internet aus."

#: pas/plugins/identity/core/drivers/settings.py:240
msgid "Only these groups may sign in"
msgstr "Nur diese Gruppen dürfen sich anmelden"

#: pas/plugins/identity/core/controlpanel/interfaces.py:363
msgid "Order"
msgstr "Reihenfolge"

#: pas/plugins/identity/core/behaviors/configure.zcml:18
msgid "Password storage"
msgstr "Passwort-Speicher"

#: pas/plugins/identity/core/controlpanel/interfaces.py:475
msgid "Path of the folder the group container lives in, relative to the site root. Only read when a group container id is set."
msgstr "Pfad des Ordners, in dem sich der Gruppenbehälter befindet, relativ zum Website-Stammverzeichnis. Wird nur gelesen, wenn eine Gruppen-Container-ID gesetzt ist."

#: pas/plugins/identity/core/controlpanel/interfaces.py:437
msgid "Path of the folder the profile container lives in, relative to the site root. Empty means the site root itself."
msgstr "Pfad des Ordners, in dem sich der Profilbehälter befindet, relativ zum Website-Stammverzeichnis. Leer bedeutet das Website-Stammverzeichnis selbst."

#: pas/plugins/identity/core/controlpanel/interfaces.py:530
msgid "Paths the profile gate leaves alone"
msgstr "Pfade, die das Profiltor allein lässt"

#: pas/plugins/identity/core/behaviors/details.py:62
msgid "Picture"
msgstr "Bild"

#: pas/plugins/identity/server/controlpanel/interfaces.py:299
msgid "Plain HTTP is only allowed for a loopback address, such as 127.0.0.1."
msgstr "Einfaches HTTP ist nur für eine Loopback-Adresse zulässig, wie 127.0.0.1."

#: pas/plugins/identity/server/profiles.zcml:20
msgid "Plone as an OAuth 2.1 / OIDC provider."
msgstr "Plone als OAuth-2.1-/OIDC-Anbieter."

#: pas/plugins/identity/core/controlpanel/interfaces.py:99
msgid "Portal type created when somebody adds a group. Installing this add-on points it at UserGroup. The type must provide IGroupContent, and one that does not hands group creation back to Plone's own source_groups."
msgstr "Portal-Typ, der erstellt wird, wenn jemand eine Gruppe hinzufügt. Durch das Installieren dieses Add-ons wird es auf UserGroup verwiesen. Der Typ muss IGroupContent bereitstellen, und einer, der es nicht tut, übergibt die Gruppenerstellung an Plones eigene source_groups."

#: pas/plugins/identity/core/controlpanel/interfaces.py:71
msgid "Portal type created when somebody adds a user. Installing this add-on points it at UserProfile; change it only to substitute a user type of your own. The type must provide IUserContent, and one that does not is refused rather than created -- adding a user then falls back to Plone's own source_users, which is stock behaviour rather than a failure. Empty does the same."
msgstr "Portal-Typ, der erstellt wird, wenn jemand einen Benutzer hinzufügt. Durch das Installieren dieses Add-ons wird es auf UserProfile verwiesen; ändern Sie es nur, um einen Benutzertyp Ihrer eigenen zu ersetzen. Der Typ muss IUserContent bereitstellen, und einer, der es nicht tut, wird abgelehnt, anstatt erstellt zu werden -- Das Hinzufügen eines Benutzers fällt dann auf Plones eigene source_users zurück, was Standardverhalten und keine Fehler ist. Leer macht dasselbe."

#: pas/plugins/identity/core/controlpanel/interfaces.py:506
msgid "Portal type used when this add-on creates the group container. The parent folder must allow it; when it does not, creating the container fails rather than choosing another type."
msgstr "Portal-Typ, der verwendet wird, wenn dieses Add-on den Gruppenbehälter erstellt. Der übergeordnete Ordner muss es zulassen; wenn nicht, schlägt das Erstellen des Behälters fehl, anstatt einen anderen Typ zu wählen."

#: pas/plugins/identity/core/controlpanel/interfaces.py:464
msgid "Portal type used when this add-on creates the profile container. The parent folder must allow it; when it does not, creating the container fails rather than choosing another type."
msgstr "Portal-Typ, der verwendet wird, wenn dieses Add-on den Profilbehälter erstellt. Der übergeordnete Ordner muss es zulassen; wenn nicht, schlägt das Erstellen des Behälters fehl, anstatt einen anderen Typ zu wählen."

#: pas/plugins/identity/core/controlpanel/interfaces.py:233
msgid "Portraits"
msgstr "Porträts"

#: pas/plugins/identity/core/controlpanel/interfaces.py:364
msgid "Position among the providers. Stored rather than derived: records live in a BTree and read back alphabetically, and this is the order the login buttons appear in."
msgstr "Position unter den Anbietern. Gespeichert statt abgeleitet: Datensätze leben in einem BTree und werden alphabetisch zurückgelesen, und dies ist die Reihenfolge, in der die Anmeldungsschaltflächen erscheinen."

#: pas/plugins/identity/profiles/default/types/PrincipalsContainer.xml
msgid "Principals folder"
msgstr "Ordner für Benutzer und Gruppen"

#: pas/plugins/identity/core/drivers/settings.py:271
msgid "Profile"
msgstr "Profil"

#: pas/plugins/identity/core/controlpanel/interfaces.py:446
msgid "Profile container id"
msgstr "Profil-Container-ID"

#: pas/plugins/identity/core/controlpanel/interfaces.py:436
msgid "Profile container parent"
msgstr "Profil-Container-Übergeordnete"

#: pas/plugins/identity/core/controlpanel/interfaces.py:453
msgid "Profile container title"
msgstr "Profil-Container-Titel"

#: pas/plugins/identity/core/controlpanel/interfaces.py:463
msgid "Profile container type"
msgstr "Profil-Container-Typ"

#: pas/plugins/identity/core/behaviors/configure.zcml:73
msgid "Profile details"
msgstr "Profildetails"

#: pas/plugins/identity/core/controlpanel/interfaces.py:397
msgid "Profile field"
msgstr "Profilfeld"

#: pas/plugins/identity/core/controlpanel/interfaces.py:517
msgid "Profiles in these workflow states are visible to user enumeration and to the properties plugin."
msgstr "Profile in diesen Arbeitsablaufzuständen sind sichtbar für die Benutzeraufzählung und das Eigenschaften-Plug-in."

#: pas/plugins/identity/core/controlpanel/interfaces.py:379
msgid "Property map"
msgstr "Eigenschaftszuordnung"

#: pas/plugins/identity/core/controlpanel/interfaces.py:161
msgid "Provider discovery timeout in seconds"
msgstr "Provider-Erkennungs-Zeitüberschreitung in Sekunden"

#: pas/plugins/identity/core/controlpanel/interfaces.py:414
msgid "Provider group"
msgstr "Anbieter-Gruppe"

#: pas/plugins/identity/core/controlpanel/interfaces.py:406
msgid "Provider-side group name to local group id, applied on every login. Empty by default: a provider grants no group until somebody says which of its groups mean something here, and a name with no entry grants nothing rather than creating a group. A login only ever takes back a group the same provider granted, so a group given to somebody by hand survives."
msgstr "Anbieter-seitiger Gruppenname zu lokaler Gruppen-ID, angewendet bei jeder Anmeldung. Standardmäßig leer: Ein Anbieter gewährt keine Gruppe, bis jemand sagt, welche seiner Gruppen hier bedeutsam sind, und ein Name ohne Eintrag gewährt nichts, anstatt eine Gruppe zu erstellen. Eine Anmeldung nimmt nur eine Gruppe wieder zurück, die der gleiche Anbieter gewährt hat, daher überlebt eine Gruppe, die von Hand gegeben wurde."

#: pas/plugins/identity/profiles/default/workflows/user_group_workflow/definition.xml
#: pas/plugins/identity/profiles/default/workflows/user_profile_workflow/definition.xml
msgid "Provides access to workflow history"
msgstr "Bietet Zugriff auf die Arbeitsablauf-Verlauf"

#: pas/plugins/identity/profiles/default/workflows/user_group_workflow/definition.xml
#: pas/plugins/identity/profiles/default/workflows/user_profile_workflow/definition.xml
msgid "Reactivate"
msgstr "Reaktivieren"

#: pas/plugins/identity/core/controlpanel/interfaces.py:189
msgid "Record IP address and user agent"
msgstr "IP-Adresse und Benutzer-Agent aufzeichnen"

#: pas/plugins/identity/server/controlpanel/interfaces.py:359
msgid "Redirect URIs"
msgstr "Umleitungs-URIs"

#: pas/plugins/identity/server/interfaces.py:180
msgid "Refresh token lifetime (seconds)"
msgstr "Aktualisierungstoken-Lebensdauer (Sekunden)"

#: pas/plugins/identity/server/interfaces.py:181
msgid "Refresh tokens are rotated on every use, so this is how long a client may stay away before a human has to sign in again."
msgstr "Aktualisierungstokens werden bei jeder Verwendung gedreht, daher ist dies, wie lange ein Client abwesend sein darf, bevor sich ein Mensch erneut anmelden muss."

#: pas/plugins/identity/server/interfaces.py:129
msgid "Registered OAuth clients"
msgstr "Registrierte OAuth-Clients"

#: pas/plugins/identity/server/profiles.zcml:29
msgid "Remove the authorization server's settings and browser layer."
msgstr "Entfernen Sie die Einstellungen und Browser-Layer des Autorisierungsservers."

#: pas/plugins/identity/profiles/default/workflows/user_profile_workflow/definition.xml
msgid "Reopen"
msgstr "Wieder öffnen"

#: pas/plugins/identity/core/controlpanel/interfaces.py:572
msgid "Required profile fields"
msgstr "Erforderliche Profilfelder"

#: pas/plugins/identity/core/contents/profile.py:86
msgid "Required: it is how this user is named everywhere the site shows them, and a provider is not obliged to send one."
msgstr "Erforderlich: Wie dieser Benutzer überall dort benannt wird, wo die Website ihn zeigt, und ein Anbieter ist nicht verpflichtet, einen zu senden."

#: pas/plugins/identity/core/behaviors/roles.py:68
msgid "Roles"
msgstr "Rollen"

#: pas/plugins/identity/core/drivers/settings.py:97
msgid "Scope"
msgstr "Bereich"

#: pas/plugins/identity/server/controlpanel/interfaces.py:387
msgid "Scopes"
msgstr "Bereiche"

#: pas/plugins/identity/server/controlpanel/interfaces.py:412
msgid "Secret hash"
msgstr "Geheimnishash"

#: pas/plugins/identity/profiles/default/workflows/user_profile_workflow/definition.xml
msgid "Send the profile back for completion."
msgstr "Senden Sie das Profil zur Vervollständigung zurück."

#: pas/plugins/identity/core/controlpanel/interfaces.py:310
msgid "Show on the login screen"
msgstr "Auf dem Anmeldungsbildschirm anzeigen"

#: pas/plugins/identity/core/controlpanel/interfaces.py:292
msgid "Shown on the login button."
msgstr "Auf der Anmeldungsschaltfläche angezeigt."

#: pas/plugins/identity/server/controlpanel/interfaces.py:340
msgid "Shown to the user on the consent screen, which is the one place a person decides whether to trust this client. A client id is not a name."
msgstr "Dem Benutzer auf dem Zustimmungsbildschirm angezeigt, was der einzige Ort ist, an dem eine Person entscheidet, ob sie diesem Client vertraut. Eine Client-ID ist kein Name."

#: pas/plugins/identity/core/contents/group.py:65
msgid "Shown wherever the group is listed."
msgstr "Überall dort angezeigt, wo die Gruppe aufgelistet ist."

#: pas/plugins/identity/core/behaviors/details.py:63
msgid "Shown wherever this user is represented. When it is empty the portrait stored on the member is used instead, and failing that the user's initials."
msgstr "Überall dort angezeigt, wo dieser Benutzer vertreten ist. Wenn es leer ist, wird stattdessen das auf dem Mitglied gespeicherte Porträt verwendet, und in Ermangelung dessen die Initialen des Benutzers."

#: pas/plugins/identity/server/interfaces.py:140
msgid "Signing key ring"
msgstr "Signatur-Schlüsselbund"

#: pas/plugins/identity/core/behaviors/roles.py:74
msgid "Site-wide roles every member of this group holds. The same roles the groups control panel sets, readable and writable here so that an export carries them and an import restores them."
msgstr "Website-weite Rollen, die jedes Mitglied dieser Gruppe hält. Die gleichen Rollen, die die Gruppen-Kontrollpanel setzt, lesbar und beschreibbar hier, damit ein Export sie trägt und ein Import sie wiederherstellt."

#: pas/plugins/identity/core/controlpanel/view.py:27
msgid "Site-wide settings for external identity providers. The provider list is stored as JSON; the frontend control panel edits it one provider at a time, with a form generated from each driver."
msgstr "Website-weite Einstellungen für externe Identitätsanbieter. Die Anbieterliste wird als JSON gespeichert; das Frontend-Kontrollpanel bearbeitet sie einen Anbieter nach dem anderen mit einem aus jedem Treiber erzeugten Formular."

#: pas/plugins/identity/core/drivers/settings.py:182
msgid "Some providers send email_verified as the string \"true\" rather than as a boolean -- Oracle Access Manager does, and so do some Keycloak configurations. Only a real boolean counts here, so against such a provider every address arrives unverified and nothing explains why. Switch this on for that provider only, having established that this is what it does: it repairs the value before anything reads it, and changes nothing about what a verified address then means."
msgstr "Einige Anbieter senden email_verified als Zeichenfolge \"true\" anstatt als boolescher Wert -- Oracle Access Manager tut dies, ebenso wie einige Keycloak-Konfigurationen. Nur ein echter boolescher Wert zählt hier, daher kommt gegen einen solchen Anbieter jede Adresse unverifiziert an und nichts erklärt, warum. Schalten Sie dies nur für diesen Anbieter ein, nachdem Sie festgestellt haben, dass dies der Fall ist: Es repariert den Wert, bevor etwas ihn liest, und ändert nichts daran, was eine verifizierte Adresse dann bedeutet."

#: pas/plugins/identity/profiles/default/workflows/user_profile_workflow/definition.xml
msgid "Stop enumerating this account."
msgstr "Stoppen Sie die Aufzählung dieses Kontos."

#: pas/plugins/identity/profiles/default/workflows/user_group_workflow/definition.xml
msgid "Stop this group granting anything."
msgstr "Stoppen Sie diese Gruppe bei der Gewährung von Etwas."

#: pas/plugins/identity/core/controlpanel/interfaces.py:358
msgid "Style"
msgstr "Stil"

#: pas/plugins/identity/core/drivers/settings.py:162
msgid "Switch it off to authenticate against this provider while admitting only people who already have an account here. A site federating with a large directory usually does not want everybody who *can* authenticate to *get* an account: membership is decided elsewhere, and the provider only proves who somebody is. An account is found by matching the verified address, so the two switches below have to be on as well -- without them there is nothing to match on and nobody would ever be admitted."
msgstr "Schalten Sie es aus, um sich gegen diesen Anbieter zu authentifizieren, während Sie nur Menschen zulassen, die bereits ein Konto hier haben. Eine Website, die sich mit einem großen Verzeichnis verbündet, möchte normalerweise nicht, dass jeder, der sich *authentifizieren kann, ein Konto *erhält: Die Mitgliedschaft wird anderswo entschieden, und der Anbieter beweist nur, wer jemand ist. Ein Konto wird durch Abgleich der verifizierten Adresse gefunden, daher müssen die beiden unten stehenden Schalter auch aktiviert sein -- ohne sie gibt es nichts zu vergleichen, und niemand würde jemals zugelassen werden."

#: pas/plugins/identity/core/drivers/settings.py:277
msgid "Switch it off to keep the provider for signing in while deciding group membership here. A site may trust a provider to say who somebody is without trusting it to say what they may do, and group membership is usually what grants permissions. Switching it off leaves the groups this provider already granted in place: taking those away is a separate decision, and one to make deliberately rather than at the next login."
msgstr "Schalten Sie es aus, um den Anbieter zum Anmelden beizubehalten, während Sie hier die Gruppenmitgliedschaft entscheiden. Eine Website kann einem Anbieter vertrauen, zu sagen, wer jemand ist, ohne ihm zu vertrauen, zu sagen, was sie tun dürfen, und Gruppenmitgliedschaft ist normalerweise das, was Berechtigungen vergibt. Durch das Ausschalten bleiben die von diesem Anbieter bereits gewährten Gruppen erhalten: Das Wegnehmen derer ist eine separate Entscheidung, die bewusst und nicht bei der nächsten Anmeldung getroffen wird."

#: pas/plugins/identity/profiles/default/workflows/user_group_workflow/definition.xml
#: pas/plugins/identity/profiles/default/workflows/user_profile_workflow/definition.xml
msgid "The ID of the user who performed the last transition"
msgstr "Die ID des Benutzers, der den letzten Übergang durchgeführt hat"

#: pas/plugins/identity/server/controlpanel/interfaces.py:402
msgid "The Plone user a client-credentials token acts as. Only meaningful for a client registered for that grant, which has no person behind it and would otherwise act as nobody."
msgstr "Der Plone-Benutzer, für den ein Client-Anmeldeinformationen-Token fungiert. Nur bedeutsam für einen Client, der für diese Gewährung registriert ist, der keine Person hinter sich hat und ansonsten als niemand fungieren würde."

#: pas/plugins/identity/server/interfaces.py:153
msgid "The `iss` value this server puts in tokens, and the base for its discovery document. Configured rather than derived from the portal URL, because it must stay byte-identical across every deployment detail that can rewrite a URL -- a proxy, a virtual host, a trailing slash -- or clients will reject the tokens."
msgstr "Der `iss`-Wert, den dieser Server in Tokens einfügt, und die Grundlage für sein Erkennungsdokument. Konfiguriert, anstatt von der Portal-URL abgeleitet, da er über alle Bereitstellungsdetails, die eine URL umschreiben können, byte-identisch bleiben muss -- ein Proxy, ein virtueller Host, einen Schrägstrich hinten -- oder Clients werden die Tokens ablehnen."

#: pas/plugins/identity/profiles/default/workflows/user_profile_workflow/definition.xml
msgid "The account should no longer appear anywhere. Excluded from enumeration by the default registry setting; the Profile and its data are kept."
msgstr "Das Konto sollte nirgendwo mehr erscheinen. Ausgeschlossen von der Aufzählung durch die Standardregistrierungseinstellung; Das Profil und seine Daten werden beibehalten."

#: pas/plugins/identity/core/behaviors/email.py:97
msgid "The address that stands for this person: the first verified one in the list above, or the first one at all when none is verified. Derived rather than typed, so there is no second value to disagree with the list."
msgstr "Die Adresse, die für diese Person steht: die erste verifizierte in der obigen Liste oder die erste überhaupt, wenn keine verifiziert ist. Abgeleitet statt eingegeben, daher gibt es keinen zweiten Wert, der mit der Liste uneinig ist."

#: pas/plugins/identity/core/behaviors/configure.zcml:50
msgid "The addresses this person is reached and recognised by."
msgstr "Die Adressen, unter denen diese Person erreichbar ist und erkannt wird."

#: pas/plugins/identity/core/behaviors/email.py:76
msgid "The addresses this person uses, most preferred first. At least one is required: a Profile exists to be the thing somebody is reached and recognised by. Adding an address here does not prove it -- verifying one sends a link to it, and only an address this site has verified can be used to sign in or to attach a new provider account to this one."
msgstr "Die Adressen, die diese Person verwendet, bevorzugt zuerst. Mindestens eine ist erforderlich: Ein Profil existiert, um das zu sein, das jemand erreichbar ist und erkannt wird. Das Hinzufügen einer Adresse hier beweist es nicht -- Das Verifizieren einer sendet einen Link dazu, und nur eine Adresse, die diese Website verifiziert hat, kann zum Anmelden oder zum Anhängen eines neuen Anbieterkontos an dieses verwendet werden."

#: pas/plugins/identity/core/drivers/settings.py:59
msgid "The email address"
msgstr "Die E-Mail-Adresse"

#: pas/plugins/identity/core/controlpanel/interfaces.py:49
msgid "The frontend route the provider redirects to after login. A path such as /login-identity is resolved against this site's URL and is what most deployments want. Give an absolute URL instead when the frontend is served from another origin, since no portal URL can describe one Plone is never reached on. It is a route in the frontend rather than a backend view: the frontend reads code and state off the query string and posts them to @identity-callback. Either way it must match the redirect URI registered with every provider exactly."
msgstr "Die Frontend-Route, zu der der Anbieter nach der Anmeldung umleitet. Ein Pfad wie /login-identity wird gegen die URL dieser Website aufgelöst und ist das, was die meisten Bereitstellungen möchten. Geben Sie stattdessen eine absolute URL an, wenn das Frontend von einer anderen Quelle bereitgestellt wird, da keine Portal-URL beschreiben kann, auf die Plone nie reicht. Es ist eine Route im Frontend statt einer Backend-Ansicht: Das Frontend liest Code und Zustand aus der Abfragezeichenfolge und postet sie an @identity-callback. In jedem Fall muss es genau mit der bei jedem Anbieter registrierten Umleitungs-URI übereinstimmen."

#: pas/plugins/identity/profiles/default/workflows/user_group_workflow/definition.xml
msgid "The group is enumerated and grants membership to the Profiles that list it."
msgstr "Die Gruppe wird aufgezählt und gewährt Mitgliedschaft den Profilen, die sie auflistet."

#: pas/plugins/identity/profiles/default/workflows/user_group_workflow/definition.xml
msgid "The group stops being enumerated and stops granting membership, without being deleted and without editing a single Profile."
msgstr "Die Gruppe wird nicht mehr aufgezählt und gewährt keine Mitgliedschaft mehr, ohne gelöscht zu werden und ohne ein einzelnes Profil zu bearbeiten."

#: pas/plugins/identity/core/behaviors/configure.zcml:38
msgid "The groups this principal belongs to."
msgstr "Die Gruppen, denen dieser Benutzer oder diese Gruppe angehört."

#: pas/plugins/identity/core/behaviors/membership.py:82
msgid "The groups this principal belongs to. Membership is kept on the member rather than on the group, so editing this field and calling api.group.add_user are two ways to the same place. On a group, this nests it: everybody in this group is also in every group named here."
msgstr "Die Gruppen, denen dieser Benutzer oder diese Gruppe angehört. Die Mitgliedschaft wird auf dem Mitglied statt auf der Gruppe geführt, daher sind das Bearbeiten dieses Felds und das Aufrufen von api.group.add_user zwei Wege zum selben Ort. In einer Gruppe verschachtelt dies es: Jeder in dieser Gruppe ist auch in jeder hier genannten Gruppe."

#: pas/plugins/identity/core/drivers/settings.py:83
msgid "The identifier this provider issued for this site."
msgstr "Die Kennung, die dieser Anbieter für diese Website ausgestellt hat."

#: pas/plugins/identity/profiles/default/workflows/user_group_workflow/definition.xml
#: pas/plugins/identity/profiles/default/workflows/user_profile_workflow/definition.xml
msgid "The last transition"
msgstr "Der letzte Übergang"

#: pas/plugins/identity/core/controlpanel/interfaces.py:336
msgid "The login button's background. Empty leaves the frontend's own styling alone."
msgstr "Der Hintergrund der Anmeldungsschaltfläche. Leer lässt die eigene Gestaltung des Frontends allein."

#: pas/plugins/identity/core/controlpanel/interfaces.py:347
msgid "The login button's text and icon colour. Empty leaves the frontend's own styling alone."
msgstr "Die Text- und Symbolfarbe der Anmeldungsschaltfläche. Leer lässt die eigene Gestaltung des Frontends allein."

#: pas/plugins/identity/core/contents/profile.py:80
msgid "The name this user logs in with."
msgstr "Der Name, mit dem sich dieser Benutzer anmeldet."

#: pas/plugins/identity/core/drivers/settings.py:356
msgid "The other site's URL, as it serves /.well-known/openid-configuration -- for a Plone site that is the site root, with no path segment after it."
msgstr "Die URL der anderen Website, wie sie /.well-known/openid-configuration bereitstellt -- Für eine Plone-Website, die die Website-Wurzel ist, ohne Pfadsegment danach."

#: pas/plugins/identity/profiles/default/workflows/user_profile_workflow/definition.xml
msgid "The profile exists but the user has not completed it. Still enumerable: the account works, it is just sparse."
msgstr "Das Profil existiert, aber der Benutzer hat es nicht ausgefüllt. Noch aufzählbar: Das Konto funktioniert, es ist nur spärlich."

#: pas/plugins/identity/core/controlpanel/interfaces.py:631
msgid "The profile gate"
msgstr "Das Profiltor"

#: pas/plugins/identity/core/drivers/settings.py:60
msgid "The provider's subject identifier"
msgstr "Die Fachkennung des Anbieters"

#: pas/plugins/identity/core/drivers/settings.py:58
msgid "The provider's username"
msgstr "Der Benutzername des Anbieters"

#: pas/plugins/identity/core/drivers/settings.py:375
msgid "The realm's URL, https://<server>/realms/<realm> -- not the server root, which serves no discovery document."
msgstr "Die URL des Bereichs, https://<server>/realms/<realm> -- nicht die Server-Wurzel, die kein Erkennungsdokument bereitstellt."

#: pas/plugins/identity/core/behaviors/configure.zcml:63
msgid "The site-wide roles this group grants its members."
msgstr "Die Website-weiten Rollen, die diese Gruppe ihren Mitgliedern vergibt."

