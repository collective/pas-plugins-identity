#. Default: "Search by name or login to find somebody in this group."
#: components/Views/GroupsView/MemberResults
msgid "group-view-search-hint"
msgstr "Suchen Sie nach Name oder Anmeldename, um jemanden in dieser Gruppe zu finden."

#. Default: "Name or login"
#: components/Views/GroupsView/MemberSearch
msgid "group-view-search-placeholder"
msgstr "Name oder Anmeldename"

#. Default: "Searching…"
#: components/Views/GroupsView/MemberResults
msgid "group-view-searching"
msgstr "Suche läuft…"

#. Default: "through {groups}"
#: components/Views/GroupsView/MemberRow
msgid "group-view-through"
msgstr "durch {groups}"

#. Default: "not verified"
#: components/Welcome/WelcomeCard
msgid "not verified"
msgstr "nicht verifiziert"

#. Default: "Remove this entry from the list? It is gone once the form is saved."
#: components/Widgets/OrderedListTable/OrderedListTable
msgid "ordered-list-confirm-delete"
msgstr "Diesen Eintrag aus der Liste entfernen? Es ist weg, sobald das Formular gespeichert wird."

#. Default: "{value} is already on the list."
#: components/Widgets/OrderedStringListWidget/OrderedStringListWidget
msgid "ordered-list-duplicate"
msgstr "{value} ist bereits in der Liste."

#. Default: "Nothing has been added yet."
#: components/Widgets/OrderedListTable/OrderedListTable
msgid "ordered-list-empty"
msgstr "Es wurde noch nichts hinzugefügt."

#. Default: "You have more than one verified email address. Choose the one this site should use for you before you continue."
#: components/ProfileGate/ProfileGate
msgid "profile-gate-confirm-email"
msgstr "Sie haben mehr als eine verifizierte E-Mail-Adresse. Wählen Sie diejenige aus, die diese Website für Sie verwenden soll, bevor Sie fortfahren."

#. Default: "Unnamed user"
#: components/Views/ProfileView
msgid "profile-view-unnamed"
msgstr "Unbenannter Benutzer"

#. Default: "Which service this provider talks to. It decides the rest of the form, and it cannot be changed afterwards."
#: helpers/providerSchema
msgid "provider-driver-help"
msgstr "Mit welchem Service dieser Anbieter spricht. Es entscheidet über den Rest des Formulars und kann danach nicht geändert werden."

#. Default: "The driver's icon, used until one is uploaded."
#: components/Widgets/ProviderIconWidget
msgid "provider-icon-default"
msgstr "Das Symbol des Treibers, das bis zur Hochladung eines verwendet wird."

#. Default: "An SVG file. It is drawn in the button, so it takes the button colours; anything else is refused."
#: components/Widgets/ProviderIconWidget
msgid "provider-icon-hint"
msgstr "Eine SVG-Datei. Sie wird in der Schaltfläche gezeichnet, daher werden die Schaltflächenfarben verwendet; alles andere wird abgelehnt."

#. Default: "Used in URLs and stored with every identity linked through this provider, so it is permanent."
#: helpers/providerSchema
msgid "provider-id-help"
msgstr "In URLs verwendet und mit jeder Identität gespeichert, die über diesen Anbieter verknüpft ist, daher ist es dauerhaft."

#. Default: "signing"
#: components/ControlPanel/ClientsPanel
msgid "signing"
msgstr "signiert"

#. Default: "user avatar"
#: components/UserMenu/UserAvatar
msgid "user avatar"
msgstr "Benutzer-Avatar"

#. Default: "The provider is switched off, so this identity cannot sign anybody in."
#: components/ControlPanel/UserAccountPanel
msgid "user-account-disabled-help"
msgstr "Der Anbieter ist ausgeschaltet, daher kann sich über diese Identität niemand anmelden."

#. Default: "That could not be read."
#: components/ControlPanel/UserAccountPanel
msgid "user-account-failed"
msgstr "Das konnte nicht gelesen werden."

#. Default: "The provider was removed while this identity was still stored against it. Nobody can sign in through it, and nothing was deleted."
#: components/ControlPanel/UserAccountPanel
msgid "user-account-gone-help"
msgstr "Der Anbieter wurde entfernt, während diese Identität noch dagegen gespeichert war. Niemand kann sich über ihn anmelden, und nichts wurde gelöscht."

#. Default: "last used {date}"
#: components/ControlPanel/UserAccountPanel
msgid "user-account-last-used"
msgstr "zuletzt verwendet {date}"

#. Default: "linked {date}"
#: components/ControlPanel/UserAccountPanel
msgid "user-account-linked"
msgstr "verknüpft {date}"

#. Default: "Loading…"
#: components/ControlPanel/UserAccountPanel
msgid "user-account-loading"
msgstr "Wird geladen…"

#. Default: "Not in the retained log"
#: components/ControlPanel/UserAccountPanel
msgid "user-account-never"
msgstr "Nicht im Audit-Protokoll"

#. Default: "Not the same as never: the authentication log is bounded, so an account dormant longer than the retention period has had its entries dropped."
#: components/ControlPanel/UserAccountPanel
msgid "user-account-never-help"
msgstr "Nicht dasselbe wie nie: Das Authentifizierungs-Protokoll ist begrenzt, daher hatte ein Konto, das länger als die Aufbewahrungsdauer ruhte, seine Einträge gelöscht."

#. Default: "never used"
#: components/ControlPanel/UserAccountPanel
msgid "user-account-never-used"
msgstr "nie verwendet"

#. Default: "This account has no profile, so it carries no addresses."
#: components/ControlPanel/UserAccountPanel
msgid "user-account-no-addresses"
msgstr "Dieses Konto hat kein Profil, daher hat es keine Adressen."

#. Default: "Nothing recorded."
#: components/ControlPanel/UserAccountPanel
msgid "user-account-no-events"
msgstr "Nichts aufgezeichnet."

#. Default: "This account signs in with a password only."
#: components/ControlPanel/UserAccountPanel
msgid "user-account-no-providers"
msgstr "Dieses Konto meldet sich nur mit einem Passwort an."

#. Default: "What this account is made of"
#: components/ControlPanel/UserAccountPanel
msgid "user-account-sections"
msgstr "Woraus dieses Konto besteht"

#. Default: "verified"
#: components/Welcome/WelcomeCard
msgid "verified"
msgstr "verifiziert"

#. Default: "verifying only"
#: components/ControlPanel/ClientsPanel
msgid "verifying only"
msgstr "nur Verifizierung"

#. Default: "{total} of {size} in the ring, signing with {algorithm}. Public keys are published at {jwks}."
#: components/ControlPanel/ClientsPanel
msgid "{total} of {size} in the ring, signing with {algorithm}."
msgstr "{total} von {size} im Ring, Signierung mit {algorithm}. Öffentliche Schlüssel werden veröffentlicht unter {jwks}."
