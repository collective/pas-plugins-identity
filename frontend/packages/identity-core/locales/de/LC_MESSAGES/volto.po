#: components/Login/LoginForm
msgid "That sign-in option is not available right now."
msgstr "Diese Anmeldeoption ist gerade nicht verfügbar."

#. Default: "The provider refused the sign-in."
#: components/Callback/CallbackCard
msgid "The provider refused the sign-in."
msgstr "Der Anbieter lehnte die Anmeldung ab."

#. Default: "This sign-in link is incomplete."
#: components/Callback/CallbackCard
msgid "This sign-in link is incomplete."
msgstr "Dieser Anmeldelink ist unvollständig."

#. Default: "Forgot your password?"
#: components/Login/PasswordForm
msgid "box_forgot_password_option"
msgstr "Passwort vergessen?"
