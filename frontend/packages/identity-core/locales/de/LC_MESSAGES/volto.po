#. Default: "Back to sign-in options"
#: components/Callback/CallbackCard
#: components/Login/LoginForm
msgid "Back to sign-in options"
msgstr "Zurück zu Anmeldeoptionen"

#. Default: "Clear"
#: components/Login/PasswordForm
msgid "Clear"
msgstr "Löschen"

#. Default: "Close"
#: components/Login/LoginOverlay
msgid "Close"
msgstr "Schließen"

#. Default: "Confirming your address…"
#: components/Callback/CallbackCard
msgid "Confirming your address"
msgstr "Adresse wird bestätigt…"

