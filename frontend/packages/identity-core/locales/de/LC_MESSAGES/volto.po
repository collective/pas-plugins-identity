#: components/Login/MagicLinkForm
msgid "Email address"
msgstr "E-Mail-Adresse"

#. Default: "Email me a link"
#: components/Login/MagicLinkForm
msgid "Email me a link"
msgstr "Senden Sie mir einen Link per E-Mail"

#. Default: "If that address can sign in here, a link is on its way. It works once, and only for a few minutes."
#: components/Login/MagicLinkForm
msgid "If that address can sign in here"
msgstr "Wenn sich diese Adresse hier anmelden kann, ist ein Link unterwegs. Es funktioniert einmal, und nur für ein paar Minuten."

#. Default: "Loading sign-in options…"
#: components/Login/LoginForm
msgid "Loading sign-in options"
msgstr "Anmeldeoptionen werden geladen…"

#. Default: "Log in"
#: components/Callback/CallbackCard
msgid "Log in"
msgstr "Anmelden"

#. Default: "Login name"
#: components/Login/PasswordForm
msgid "Login name"
msgstr "Anmeldungsname"

#. Default: "Password"
#: components/Login/PasswordForm
msgid "Password"
msgstr "Passwort"

#. Default: "Sending"
#: components/Login/MagicLinkForm
msgid "Sending"
msgstr "Wird gesendet"

#. Default: "Sign in"
#: components/Login/PasswordForm
msgid "Sign in"
msgstr "Anmelden"

#. Default: "Sign in with a password"
#: components/Login/LoginForm
msgid "Sign in with a password"
msgstr "Mit einem Passwort anmelden"

#. Default: "Signing in"
#: components/Login/PasswordForm
msgid "Signing in"
msgstr "Wird angemeldet"

#. Default: "Signing you in…"
#: components/Callback/CallbackCard
msgid "Signing you in"
msgstr "Sie werden angemeldet…"

#. Default: "Taking you to {provider}…"
#: components/Login/LoginForm
