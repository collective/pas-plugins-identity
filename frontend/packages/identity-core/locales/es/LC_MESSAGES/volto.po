#: components/Callback/CallbackCard
msgid "Log in"
msgstr "Iniciar sesión"

#. Default: "Login name"
#: components/Login/PasswordForm
msgid "Login name"
msgstr "Nombre de usuario"

#. Default: "Password"
#: components/Login/PasswordForm
msgid "Password"
